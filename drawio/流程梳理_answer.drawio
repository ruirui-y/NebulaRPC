        <mxCell id="1" parent="0" />
        <mxCell id="sec1" value="① 结构化日志 —— 让一次调用可被 grep（NLOG_* 首次接线）" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="325" as="geometry" />
        </mxCell>
        <mxCell id="s1n1" value="发起&#xa;rpc_channel.cpp:246  rpc call start&#xa;字段：request_id / trace_id /&#xa;service / method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="30" y="50" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1n2" value="rpc_channel.cpp —— 入队前被拦下（也计入指标）&#xa;:292 rejected（连接不可用）&#xa;:302 rejected（too many pending）&#xa;:319 timeout（入队前已超时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="360" y="50" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s1n3" value="rpc_server.cpp&#xa;:228 rpc server dispatch&#xa;:278 rpc server error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="790" y="50" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1n4" value="完成（唯一出口）&#xa;rpc_channel.cpp:891 LogCompletion（打点 :906）&#xa;固定字段：request_id / outcome /&#xa;service / method / latency_ms / error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="1080" y="50" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1n5" value="rpc_channel.cpp 另外两处&#xa;:455 rpc connection closed&#xa;:484 rpc protocol error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="1430" y="50" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1note" value="outcome 共 6 种（全部在 rpc_channel.cpp）&#xa;   :772 completed / server-error ← 响应回来（对端 ERROR 帧 = server-error）&#xa;   :813、:955 failed ← CompleteCallWithFailure / FailAllPending        :851 cancelled ← 完成权被取消抢到&#xa;   :292、:302 rejected ← 闸门拦下                                       :319 timeout ← 入队前已超时&#xa;⚠ outcome ≠ RpcCallState：对端回 ERROR 帧时 outcome=server-error、指标记 failed，但完成权仍是 Completed&#xa;   —— RpcCallState 表达「谁抢到完成权」，不表达成败。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="30" y="180" width="1670" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s1e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec1" source="s1n1" target="s1n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec1" source="s1n2" target="s1n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec1" source="s1n3" target="s1n4">
