  <diagram id="sec3" name="③ Trace">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="355" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sec3" value="③ Trace —— trace_id 的传播路径（跨进程因果链）" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="275" as="geometry" />
        </mxCell>
        <mxCell id="s3n1" value="rpc_channel.cpp:28  GenerateTraceId&#xa;getpid 盐 + 计数 + steady_clock&#xa;→ 16 位 hex（进程内唯一生成点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="30" y="50" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3n2" value="rpc_channel.cpp:228&#xa;meta.set_trace_id&#xa;（字段定义 rpc_meta.proto:20）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="390" y="50" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3n3" value="rpc_server.cpp&#xa;:226 取出 trace_id&#xa;:228 dispatch 日志带上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="700" y="50" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3n4" value="rpc_server.cpp&#xa;:262 SendResponse&#xa;:287 SendError（原样带回）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="1010" y="50" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3n5" value="rpc_channel.cpp:906  LogCompletion&#xa;带上同一个 trace_id&#xa;→ 两端日志串成一条链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="1330" y="50" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3note" value="为什么有了 request_id 还要 trace_id：&#xa;   request_id = 单跳内的配对 token，由 next_request_id_(rpc_channel.h:168) 分配，只活到这次响应回来&#xa;   trace_id   = 跨进程的因果标识，换连接 / 重发之后仍指向同一条业务请求&#xa;当前边界：只支持本端生成，没有「透传上游」的入口（现在没有上游）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec3">
          <mxGeometry x="30" y="165" width="1670" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec3" source="s3n1" target="s3n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec3" source="s3n2" target="s3n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec3" source="s3n3" target="s3n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec3" source="s3n4" target="s3n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sec4" name="④ 优雅关闭">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="515" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sec4" value="④ Graceful Shutdown —— 五块里唯一动了连接生命周期的一块" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="435" as="geometry" />
        </mxCell>
        <mxCell id="s4n1" value="SIGTERM handler   rpc_echo_server.cpp:43&#xa;→ EventLoop::NotifyFromSignal()   event_loop.cpp:188&#xa;只做两件信号安全的事：原子置位 + ::write(wakeup_fd_)&#xa;🚫 QueueInLoop 要取 mutex + 构造 std::function，&#xa;    在信号上下文里调用是 UB（最坏与被中断线程自己死锁）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="30" y="50" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s4n2" value="event_loop.cpp:93  Loop() 每轮末尾&#xa;signal_pending_.exchange(false)&#xa;→ signal_callback_() = server.Stop()&#xa;（真正的动作回到 loop 线程执行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="450" y="50" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="s4n3" value="rpc_server.cpp&#xa;:62 Stop → RunInLoop&#xa;:70 StopInLoop，stopping_.exchange(true) 幂等&#xa;:82 server_.Stop() ← 停 accept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="790" y="50" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="s4n4" value="tcp_server.cpp:55 Stop → :63 StopInLoop&#xa;:75 acceptor_-&gt;Stop()&#xa;acceptor.cpp:33 = DisableAll + Remove&#xa;⚠ listen fd 不在这里关，留给 ~Acceptor→~Socket&#xa;   （与 §10 同一条纪律：逻辑置死 ≠ 释放 fd）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="1130" y="50" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s4n5" value="rpc_server.cpp:21&#xa;kGracefulTimeout = 10s&#xa;到期 → CloseConnections&#xa;+ Finish(&quot;timeout&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="1490" y="50" width="190" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s4n6" value="rpc_server.cpp:91  in_flight_ == 0 ?&#xa;是 → :97 CloseConnectionsInLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="30" y="215" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s4n7" value="否 → 等&#xa;rpc_server.cpp:145 OnCallFinished（done 可能在任何线程）&#xa;fetch_sub 减到 0 且 stopping → RunInLoop(关连接)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="380" y="215" width="430" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s4n8" value="rpc_server.cpp:236  in_flight_ 在哪加&#xa;⚠「先计数再 CallMethod」：业务可能同步回调 done，&#xa;    计数晚了就会在清零之后又减一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="830" y="215" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s4n9" value="rpc_server.cpp:97  CloseConnectionsInLoop&#xa;tcp_server.cpp:101 逐个 connection-&gt;Shutdown()&#xa;⚠ 用 Shutdown 不用 ForceClose：FIN 排在&#xa;   待发缓冲之后，已生成的响应不会丢" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="1270" y="215" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s4n10" value="tcp_server.cpp&#xa;:107 CheckAllClosedInLoop&#xa;:174 由 RemoveConnectionInLoop 驱动（最后一条&#xa;连接退场即回调，不靠轮询）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="30" y="330" width="470" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s4n11" value="rpc_server.cpp:121  FinishShutdownInLoop&#xa;reason = drained / timeout&#xa;→ shutdown_complete_callback_ → loop.Quit()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec4">
          <mxGeometry x="520" y="330" width="470" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s4e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n1" target="s4n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n2" target="s4n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n3" target="s4n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n3" target="s4n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n6" target="s4n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n7" target="s4n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n8" target="s4n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n9" target="s4n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec4" source="s4n10" target="s4n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sec5" name="⑤ 应用层心跳">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="595" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sec5" value="⑤ 应用层心跳 —— 补 keepalive 探不到的洞（进程僵死）" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="515" as="geometry" />
        </mxCell>
        <mxCell id="s5n1" value="rpc_channel.cpp&#xa;:420 OnConnection（loop 线程）&#xa;:430 连接建立 → heartbeat_missed_ = 0&#xa;:518 ScheduleHeartbeatInLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="30" y="50" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5n2" value="rpc_channel.cpp&#xa;:455 断连时的 rpc connection closed&#xa;:544 CancelHeartbeatInLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="410" y="50" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5n3" value="rpc_channel.cpp:557&#xa;RunAfter(3s) → OnHeartbeatTimer&#xa;三个分支 ↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="760" y="50" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5n4" value="[1] 没有连接可探   rpc_channel.cpp:561&#xa;connection_state_ != kConnected 或 connection_ == nullptr&#xa;→ heartbeat_missed_ = 0&#xa;（不是漏写：不清零会累加到下一条连接，新连接刚建就被误杀）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="30" y="175" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5n5" value="[2] missed &gt;= 3   rpc_channel.cpp:565（第 4 个 tick 才判）&#xa;:567 NLOG_WARN → :574 ForceClose()&#xa;→ 报丧线 → Connector 重连&#xa;⚠ tick1/2/3 各发一次并 ++，tick4 才判 → 共约 12s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="570" y="175" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5n6" value="[3] 否则   rpc_channel.cpp:576&#xa;:578 ++heartbeat_missed_，:579 调 SendHeartbeatInLoop（定义 :585）&#xa;:582 结尾 ScheduleHeartbeatInLoop 续下一轮&#xa;发送即协议 HEARTBEAT（rpc_meta.proto:10），也分配 request_id（rpc_channel.cpp:596）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="1070" y="175" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5n7" value="服务端 rpc_server.cpp&#xa;:157 OnMessage&#xa;:175 HEARTBEAT 在 REQUEST 判定「之前」分流&#xa;:297 SendHeartbeatEcho（:303 trace_id 原样带回）&#xa;:181 非 HEARTBEAT → 继续走 REQUEST 处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="30" y="305" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5n8" value="客户端 rpc_channel.cpp&#xa;:503 HandleFrame&#xa;:508 HEARTBEAT → heartbeat_missed_ = 0 并提前 return&#xa;⚠ 不进 pending_calls_ → 不占 in_flight_&#xa;    → 心跳不会拖住优雅关闭（④⑤ 的咬合点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="570" y="305" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5note" value="keepalive 由对端「内核」应答，只能证明机器和网络还活着；服务端进程 hang 住而内核正常时它照样成功。两者互补，keepalive 保留。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="sec5">
          <mxGeometry x="30" y="430" width="1510" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s5e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec5" source="s5n1" target="s5n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec5" source="s5n3" target="s5n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec5" source="s5n3" target="s5n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec5" source="s5n3" target="s5n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="sec5" source="s5n4" target="s5n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e6" value="HEARTBEAT 回包" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="sec5" source="s5n7" target="s5n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
