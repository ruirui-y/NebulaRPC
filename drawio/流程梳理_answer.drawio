        </mxCell>
        <mxCell id="cv2" parent="cover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="第 3 页&#xa;① 结构化日志&#xa;让一次调用可被 grep" vertex="1">
          <mxGeometry height="100" width="280" x="320" y="50" as="geometry" />
