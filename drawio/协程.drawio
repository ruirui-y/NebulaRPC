        <mxCell id="CXk7qCbLeuDR9p2oK2AG-6" parent="CXk7qCbLeuDR9p2oK2AG-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="300" width="242.04" x="525" y="610" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-13" edge="1" parent="CXk7qCbLeuDR9p2oK2AG-1" source="CXk7qCbLeuDR9p2oK2AG-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="CXk7qCbLeuDR9p2oK2AG-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-7" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="调用协程函数" vertex="1">
          <mxGeometry height="30" width="80" x="1150" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-9" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;tasks_.emplace_back(RunCoroutine(count));&lt;/b&gt;&lt;div&gt;&lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 是&lt;b&gt;调用协程函数 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时&lt;/b&gt;直接返回的&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;调用 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时，编译器会在堆上分配协程帧（Coroutine Frame），调用 &lt;code&gt;Task::promise_type::get_return_object()&lt;/code&gt; 生成一个 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象，然后紧接着执行 &lt;code&gt;initial_suspend()&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;因为 &lt;code&gt;initial_suspend()&lt;/code&gt; 返回的是 &lt;code&gt;std::suspend_always&lt;/code&gt;，所以协程&lt;b&gt;一行代码都还没跑就立刻挂起&lt;/b&gt;了，把 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象返回给调用者并存进 &lt;code&gt;tasks_&lt;/code&gt; 向量里&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;直到下面执行 &lt;code&gt;task.Start()&lt;/code&gt;（内部调用 &lt;code&gt;handle_.resume()&lt;/code&gt;），&lt;code&gt;RunCoroutine&lt;/code&gt; 的函数体才真正开始运行&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="1025" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-16" edge="1" parent="CXk7qCbLeuDR9p2oK2AG-1" source="CXk7qCbLeuDR9p2oK2AG-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="CXk7qCbLeuDR9p2oK2AG-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-11" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="唤醒并执行协程函数" vertex="1">
          <mxGeometry height="30" width="110" x="1550" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-12" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;tasks_.emplace_back(RunCoroutine(count));&lt;/b&gt;&lt;div&gt;&lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 是&lt;b&gt;调用协程函数 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时&lt;/b&gt;直接返回的&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;调用 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时，编译器会在堆上分配协程帧（Coroutine Frame），调用 &lt;code&gt;Task::promise_type::get_return_object()&lt;/code&gt; 生成一个 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象，然后紧接着执行 &lt;code&gt;initial_suspend()&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;因为 &lt;code&gt;initial_suspend()&lt;/code&gt; 返回的是 &lt;code&gt;std::suspend_always&lt;/code&gt;，所以协程&lt;b&gt;一行代码都还没跑就立刻挂起&lt;/b&gt;了，把 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象返回给调用者并存进 &lt;code&gt;tasks_&lt;/code&gt; 向量里&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;直到下面执行 &lt;code&gt;task.Start()&lt;/code&gt;（内部调用 &lt;code&gt;handle_.resume()&lt;/code&gt;），&lt;code&gt;RunCoroutine&lt;/code&gt; 的函数体才真正开始运行&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="1440" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-14" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="co_await" vertex="1">
          <mxGeometry height="30" width="110" x="2080" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-15" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;nebula::example::EchoResponse response =&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; co_await nebula::rpc::RpcAwaiter&amp;lt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; nebula::example::EchoRequest,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; nebula::example::EchoResponse&amp;gt;(&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;amp;channel_,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; echo_method_,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; std::move(request),&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; std::chrono::milliseconds(opts_.timeout_ms));&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;code&gt;co_await&lt;/code&gt; 等待的对象&lt;/b&gt;是一个临时的 &lt;b&gt;&lt;code&gt;RpcAwaiter&lt;/code&gt;&lt;/b&gt; 对象，而不是 &lt;code&gt;Task&lt;/code&gt;。&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;code&gt;co_await&lt;/code&gt; 表达式的返回值&lt;/b&gt;是 &lt;code&gt;RpcAwaiter::await_resume()&lt;/code&gt; 的返回值，也就是 &lt;b&gt;&lt;code&gt;nebula::example::EchoResponse&lt;/code&gt;&lt;/b&gt;（或者在超时/失败时直接抛出 &lt;code&gt;RpcError&lt;/code&gt; 异常）&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;启动与挂起期&lt;/b&gt;：外层调用 &lt;code&gt;task.Start()&lt;/code&gt; -&amp;gt; 内部调用 &lt;code&gt;handle_.resume()&lt;/code&gt; -&amp;gt; 协程开始跑 &lt;code&gt;for&lt;/code&gt; 循环 -&amp;gt; 构造 &lt;code&gt;RpcAwaiter&lt;/code&gt; 并执行 &lt;code&gt;co_await&lt;/code&gt; -&amp;gt; 调用 &lt;code&gt;await_suspend&lt;/code&gt; 把请求塞进 &lt;code&gt;channel_-&amp;gt;CallMethod(...)&lt;/code&gt; -&amp;gt; &lt;b&gt;协程在此处挂起&lt;/b&gt; -&amp;gt; &lt;b&gt;&lt;code&gt;handle_.resume()&lt;/code&gt; 执行完毕，控制权交还给外层的 &lt;code&gt;task.Start()&lt;/code&gt; 循环&lt;/b&gt;，继续启动下一个协程。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;当网络端收到 RPC 响应后，&lt;code&gt;RpcChannel&lt;/code&gt; 触发 &lt;code&gt;done&lt;/code&gt; 回调，通过 &lt;code&gt;loop-&amp;gt;QueueInLoop&lt;/code&gt; 调用 &lt;code&gt;resumed.resume()&lt;/code&gt;，协程才会从刚才挂起的 &lt;code&gt;co_await&lt;/code&gt; 处醒来，立刻执行 &lt;code&gt;RpcAwaiter::await_resume()&lt;/code&gt; 拿到 &lt;code&gt;EchoResponse&lt;/code&gt;，继续跑完当次循环并进入下一次 &lt;code&gt;for&lt;/code&gt; 循环&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="450" x="1910" y="530" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-17" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;bool await_ready() const noexcept&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return false;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;void await_suspend(std::coroutine_handle&amp;lt;&amp;gt; handle)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 契约：co_await 必须发生在 channel 的属主 loop 线程，否则恢复可能与挂起并发&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; channel_-&amp;gt;Loop()-&amp;gt;AssertInLoopThread();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; guard_ = std::make_shared&amp;lt;ResumeGuard&amp;gt;();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; guard_-&amp;gt;handle.store(handle, std::memory_order_release);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (timeout_.count() &amp;gt; 0)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; controller_.SetTimeout(timeout_);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // done 是完成路径唯一出口：只要是个 Closure，response/超时/取消/断连都自动覆盖&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; auto* done = new RpcClosure([guard = guard_, loop = channel_-&amp;gt;Loop()]&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 推迟到队列再恢复：CallMethod 可能同步失败并内联跑完 done，直接 resume 会重入&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; loop-&amp;gt;QueueInLoop([guard]&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (const std::coroutine_handle&amp;lt;&amp;gt; resumed =&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; guard-&amp;gt;handle.exchange(nullptr);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; resumed != nullptr)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; resumed.resume();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; });&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; });&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // CallMethod 只入连接发送缓冲；批次何时 Flush 由外层调度者决定。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; channel_-&amp;gt;CallMethod(method_, &amp;amp;controller_, &amp;amp;request_, &amp;amp;response_, done);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Response await_resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; const RpcCallState state = controller_.CallState();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (state == RpcCallState::Cancelled)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; throw RpcError(state, &quot;RPC cancelled&quot;);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (state == RpcCallState::Timeout || state == RpcCallState::Failed)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; throw RpcError(state, controller_.ErrorText());&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 仲裁赢了但业务失败：服务端 ERROR 帧、响应解析失败等&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (controller_.Failed())&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; throw RpcError(RpcCallState::Failed, controller_.ErrorText());&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return std::move(response_);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="720" width="520" x="1875" y="830" as="geometry" />
        </mxCell>
      </root>
