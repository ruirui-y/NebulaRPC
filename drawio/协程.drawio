        <mxCell id="CXk7qCbLeuDR9p2oK2AG-2" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="协程函数：&lt;div&gt;&lt;div&gt;函数体内部：至少出现 co_return、co_yield、co_await 中的一个。&lt;/div&gt;&lt;div&gt;返回类型：必须有合法的嵌套 promise_type（缺失则编译报错）。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="352.5" x="271.25" y="460" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-4" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;H:\YJJ\NebulaRPC\examples\rpc_echo\rpc_echo_coroutine_benchmark_client.cpp&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="415" x="240" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-5" parent="CXk7qCbLeuDR9p2oK2AG-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="300" width="393.49" x="120.75" y="610" as="geometry" />
