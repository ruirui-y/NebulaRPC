        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-7" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="调用协程函数" vertex="1">
          <mxGeometry height="30" width="80" x="1150" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-9" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;tasks_.emplace_back(RunCoroutine(count));&lt;/b&gt;&lt;div&gt;&lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 是&lt;b&gt;调用协程函数 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时&lt;/b&gt;直接返回的&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;调用 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时，编译器会在堆上分配协程帧（Coroutine Frame），调用 &lt;code&gt;Task::promise_type::get_return_object()&lt;/code&gt; 生成一个 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象，然后紧接着执行 &lt;code&gt;initial_suspend()&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;因为 &lt;code&gt;initial_suspend()&lt;/code&gt; 返回的是 &lt;code&gt;std::suspend_always&lt;/code&gt;，所以协程&lt;b&gt;一行代码都还没跑就立刻挂起&lt;/b&gt;了，把 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象返回给调用者并存进 &lt;code&gt;tasks_&lt;/code&gt; 向量里&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;直到下面执行 &lt;code&gt;task.Start()&lt;/code&gt;（内部调用 &lt;code&gt;handle_.resume()&lt;/code&gt;），&lt;code&gt;RunCoroutine&lt;/code&gt; 的函数体才真正开始运行&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="1025" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-16" edge="1" parent="CXk7qCbLeuDR9p2oK2AG-1" source="CXk7qCbLeuDR9p2oK2AG-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="CXk7qCbLeuDR9p2oK2AG-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-11" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="唤醒并执行协程函数" vertex="1">
          <mxGeometry height="30" width="110" x="1550" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-12" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;tasks_.emplace_back(RunCoroutine(count));&lt;/b&gt;&lt;div&gt;&lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 是&lt;b&gt;调用协程函数 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时&lt;/b&gt;直接返回的&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;调用 &lt;code&gt;RunCoroutine(count)&lt;/code&gt; 时，编译器会在堆上分配协程帧（Coroutine Frame），调用 &lt;code&gt;Task::promise_type::get_return_object()&lt;/code&gt; 生成一个 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象，然后紧接着执行 &lt;code&gt;initial_suspend()&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;因为 &lt;code&gt;initial_suspend()&lt;/code&gt; 返回的是 &lt;code&gt;std::suspend_always&lt;/code&gt;，所以协程&lt;b&gt;一行代码都还没跑就立刻挂起&lt;/b&gt;了，把 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 对象返回给调用者并存进 &lt;code&gt;tasks_&lt;/code&gt; 向量里&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;直到下面执行 &lt;code&gt;task.Start()&lt;/code&gt;（内部调用 &lt;code&gt;handle_.resume()&lt;/code&gt;），&lt;code&gt;RunCoroutine&lt;/code&gt; 的函数体才真正开始运行&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="1440" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-14" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="co_await" vertex="1">
          <mxGeometry height="30" width="110" x="2080" y="475" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-15" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;auto result = co_await stub.Call&amp;lt;EchoRequest, EchoResponse&amp;gt;(&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &quot;Echo&quot;, std::move(request), options);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;br&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;CoroutineStub::Call&lt;/b&gt; 只负责查 method 再转发，真正返回的&lt;/div&gt;
&lt;div&gt;awaiter 是 &lt;b&gt;RpcResultAwaiter&amp;lt;Request, Response&amp;gt;&lt;/b&gt;（由 CoCall 构造）。&lt;/div&gt;
&lt;div&gt;&lt;br&gt;&lt;/div&gt;
&lt;div&gt;await_ready()&amp;nbsp; &amp;nbsp;→ storage_.Ready()，恒为 false&lt;/div&gt;
&lt;div&gt;await_suspend()&amp;nbsp;→ storage_.Suspend(handle)&lt;/div&gt;
&lt;div&gt;await_resume() → 返回 &lt;b&gt;RpcResult&amp;lt;Response&amp;gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;br&gt;&lt;/div&gt;
&lt;div&gt;失败不再抛 RpcError，而是带 state / error_text 的结果对象。&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="450" x="1910" y="530" as="geometry" />
        </mxCell>
        <mxCell id="CXk7qCbLeuDR9p2oK2AG-17" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;template &amp;lt;typename Request, typename Response&amp;gt;&lt;/b&gt;
&lt;div&gt;&lt;b&gt;class RpcResultAwaiter&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; detail::RpcAwaiterStorage&amp;lt;Request, Response&amp;gt; storage_;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;public:&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; bool await_ready() const noexcept&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; { return storage_.Ready(); }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; void await_suspend(std::coroutine_handle&amp;lt;&amp;gt; handle)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; { storage_.Suspend(handle); }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; RpcResult&amp;lt;Response&amp;gt; await_resume(); &amp;nbsp; // 见下方链路终点&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;};&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;bool RpcAwaiterStorage::Ready() const noexcept { return false; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;void RpcAwaiterStorage::Suspend(std::coroutine_handle&amp;lt;&amp;gt; handle)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; channel_-&amp;gt;Loop()-&amp;gt;AssertInLoopThread();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion_ = std::make_shared&amp;lt;RpcCoroutineCompletion&amp;gt;();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion_-&amp;gt;handle.store(handle, std::memory_order_release);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (options_.deadline.has_value())&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; { controller_.SetDeadline(*options_.deadline); }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; else if (options_.timeout.count() &amp;gt; 0)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; { controller_.SetTimeout(options_.timeout); }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 协程原生入口：不再构造 RpcClosure&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; channel_-&amp;gt;StartCoroutineCall(method_, &amp;amp;controller_,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;amp;request_, &amp;amp;response_, completion_);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 单次调用默认立刻发；批处理时置 flush=false 由外层统一提交&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (options_.flush) { channel_-&amp;gt;Flush(); }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="790" width="520" x="1875" y="860" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L1" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="StartCoroutineCall" vertex="1">
          <mxGeometry height="30" width="430" x="120" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C1" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;void RpcChannel::StartCoroutineCall(&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; const MethodDescriptor* method,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; RpcController* controller,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; const Message* request, Message* response,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; const shared_ptr&amp;lt;RpcCoroutineCompletion&amp;gt;&amp;amp; completion)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; loop_-&amp;gt;AssertInLoopThread();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 没有 completion 就无法恢复协程，当场失败&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (completion == nullptr) { ApplyFailure(...); return; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; BeginCall(method, controller, request, response,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; nullptr, completion); &amp;nbsp; // done = nullptr&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="120" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L2" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="BeginCall" vertex="1">
          <mxGeometry height="30" width="430" x="590" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C2" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;void RpcChannel::BeginCall(..., Closure* done,&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; shared_ptr&amp;lt;RpcCoroutineCompletion&amp;gt; completion)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 参数非法 / 序列化失败 / 编码失败&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // → ApplyFailure(Invalid) 后立刻恢复协程&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; complete_invalid(&quot;invalid RPC call arguments&quot;);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; request_id = NextRequestId();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; trace_id &amp;nbsp; = GenerateTraceId();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 先写进 completion，await_resume 才有得读&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion-&amp;gt;request_id = request_id;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion-&amp;gt;trace_id &amp;nbsp; = trace_id;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; bytes = RpcCodec::Encode(std::move(meta), payload);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; loop_-&amp;gt;RunInLoop([...] { RegisterAndSend(...); });&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="590" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L3" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="RegisterAndSend" vertex="1">
          <mxGeometry height="30" width="430" x="1060" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C3" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;void RpcChannel::RegisterAndSend(request_id, bytes, pending_call)&lt;/b&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 三道闸门：连不上 / 过载 / 已过期&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (RejectIfUnavailable(...) || RejectIfOverloaded(...) ||&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RejectIfExpired(...))&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return; &amp;nbsp; // 拒绝原因同样写进 completion 并恢复协程&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; pending_calls_.emplace(request_id, std::move(pending_call));&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; RegisterCancelCallback(...); &amp;nbsp; // 协程不经 controller 取消&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; RegisterTimeoutTimer(...);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; WriteRegisteredCall(request_id, std::move(bytes)); &amp;nbsp; // 只 Write&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="1060" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L4" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="RPC Response 回来" vertex="1">
          <mxGeometry height="30" width="430" x="1530" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C4" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;TcpConnection::HandleRead&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; → RpcChannel::OnMessage&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; → RpcCodec::Decode&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → CompleteCallWithFrame(request_id, frame)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;完成前先把统计写进 completion：&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion-&amp;gt;latency &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; = latency;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; completion-&amp;gt;remote_error_code = frame.meta.error_code();&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;这里不再 RunInLoop 包一层 done，&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;状态直接在当前 loop 线程写进 controller。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="1530" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L5" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="CompleteCallWithFrame / Failure / Timeout / Cancel" vertex="1">
          <mxGeometry height="30" width="430" x="2000" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C5" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;四条完成路径，出口统一：&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; CompleteCallWithFrame &amp;nbsp; // 正常响应&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; CompleteCallWithFailure // 断连 / 失败&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; OnTimeout &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 超时&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; CompleteCallWithCancel &amp;nbsp;// 取消&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;每条都只做两件事：&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; ApplyFrame / ApplyFailure &amp;nbsp;// 写 controller 状态&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; NotifyCompletion(call) &amp;nbsp; &amp;nbsp; // 决定恢复谁&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;exactly-once 由 PendingCall 的完成仲裁保证：&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;协程只会被 resume 一次。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="2000" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L6" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="NotifyCompletion" vertex="1">
          <mxGeometry height="30" width="430" x="2470" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C6" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;void RpcChannel::NotifyCompletion(PendingCall&amp;amp; call)&lt;/b&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (call.coroutine_completion != nullptr)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; QueueCoroutineResume(loop_, call.coroutine_completion);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return; &amp;nbsp; // 协程路径：不再跑 done&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (call.done != nullptr)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; call.done-&amp;gt;Run(); &amp;nbsp; // Legacy callback 兼容路径&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="2470" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L7" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="QueueCoroutineResume" vertex="1">
          <mxGeometry height="30" width="430" x="2940" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C7" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;void QueueCoroutineResume(&lt;/b&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; EventLoop* loop,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; const shared_ptr&amp;lt;RpcCoroutineCompletion&amp;gt;&amp;amp; completion)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; loop-&amp;gt;QueueInLoop([completion]&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (auto resumed = completion-&amp;gt;handle.exchange(&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; nullptr, std::memory_order_acq_rel);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; resumed != nullptr)&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; resumed.resume(); &amp;nbsp; // 只在 loop 线程恢复&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; });&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="430" x="2940" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-L8" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="coroutine resume → await_resume()" vertex="1">
          <mxGeometry height="30" width="430" x="3410" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="CLIFLOW-C8" parent="CXk7qCbLeuDR9p2oK2AG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;RpcResult&amp;lt;Response&amp;gt; RpcResultAwaiter::await_resume()&lt;/b&gt;
&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; // 已被恢复，直接读 controller 与 completion&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return RpcResult&amp;lt;Response&amp;gt;(&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; storage_.TakeResponse(),&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; controller.CallState(), controller.ErrorText(),&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; controller.IsCanceled(),&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; completion-&amp;gt;request_id, completion-&amp;gt;trace_id,&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; completion-&amp;gt;latency, completion-&amp;gt;remote_error_code);&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;// 业务侧拿到的是结果对象，不再靠异常分流&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;if (!result) { ... }&lt;/b&gt;&lt;/div&gt;
&lt;div&gt;&lt;b&gt;const auto&amp;amp; res = result.ResponseValue();&lt;/b&gt;&lt;/div&gt;" vertex="1">
