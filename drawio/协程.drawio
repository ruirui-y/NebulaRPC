<mxfile host="Electron" pages="5">
  <diagram id="5lguquDVMkOXs-I-70_w" name="协程基础知识">
    <mxGraphModel dx="2091" dy="1219" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="WXZXG9LCmnDOXK58-rso-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="协程基础知识" vertex="1">
          <mxGeometry height="940" width="3870" x="50" y="100" as="geometry" />
        </mxCell>
        <mxCell id="WXZXG9LCmnDOXK58-rso-5" edge="1" parent="WXZXG9LCmnDOXK58-rso-1" source="WXZXG9LCmnDOXK58-rso-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="WXZXG9LCmnDOXK58-rso-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WXZXG9LCmnDOXK58-rso-2" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;Task&amp;lt;int&amp;gt; Child()&lt;/div&gt;&lt;div&gt;&amp;nbsp;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; co_return 100;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="100" x="60" y="437" as="geometry" />
        </mxCell>
        <mxCell id="WXZXG9LCmnDOXK58-rso-4" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;Task&amp;lt;int&amp;gt; Child()&amp;nbsp;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ① 在堆(Heap)上分配一块内存，叫“协程帧 (Coroutine Frame)”&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 里面存放：函数参数、局部变量，以及一个极其重要的 promise 对象&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; auto* frame = new CoroutineFrame();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Task&amp;lt;int&amp;gt;::promise_type&amp;amp; promise = frame-&amp;gt;promise;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ② 先造出返回值 Task&amp;lt;int&amp;gt; 对象（里面存着指向 frame 的句柄 handle）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Task&amp;lt;int&amp;gt; return_obj = promise.get_return_object();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ③ 【编译器强行插入的第1刀】决定协程是一创建就跑，还是先停住&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; co_await promise.initial_suspend();&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 👉 注意：只要这里挂起，Child() 函数立刻 return 上面的 return_obj 给外层调用者！&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; try {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // ④ 真正执行你写的函数体：co_return 100;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; promise.return_value(100); // 把 100 存进 promise.value_ 里&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; } catch (...) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 如果函数体抛了未捕获异常，编译器自动帮你 catch 住并存进 promise&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; promise.unhandled_exception();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ⑤ 【编译器强行插入的第2刀】协程跑完了，决定死前怎么交接后事&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; co_await promise.final_suspend();&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="312.5" width="410" x="400" y="312.75" as="geometry" />
        </mxCell>
        <mxCell id="Ih3D33WLj90Kc8GS9kd--1" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="编辑器魔改协程函数" vertex="1">
          <mxGeometry height="30" width="110" x="210" y="150" as="geometry" />
        </mxCell>
        <mxCell id="EncqyCcHVGAf5G5O6ang-1" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="协程三剑客" vertex="1">
          <mxGeometry height="30" width="70" x="1170" y="150" as="geometry" />
        </mxCell>
        <mxCell id="EncqyCcHVGAf5G5O6ang-2" parent="WXZXG9LCmnDOXK58-rso-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="360" width="548.24" x="950" y="270" as="geometry" />
        </mxCell>
        <mxCell id="EncqyCcHVGAf5G5O6ang-3" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;code&gt;co_await&lt;/code&gt; 的“三步握手”与“对称转移”" vertex="1">
          <mxGeometry height="30" width="180" x="2040" y="150" as="geometry" />
        </mxCell>
        <mxCell id="EncqyCcHVGAf5G5O6ang-4" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;p&gt;在 C++20 中，只要编译器看到 &lt;code&gt;co_await some_awaiter&lt;/code&gt;，就会严格展开成 &lt;b&gt;三步握手&lt;/b&gt;：&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;第一步：&lt;code&gt;if (!awaiter.await_ready())&lt;/code&gt;&lt;/b&gt;&lt;br/&gt;先问：“数据已经准备好了吗？”如果返回 &lt;code&gt;false&lt;/code&gt;，说明没准备好，当前协程必须暂停（挂起），进入第二步。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;第二步：&lt;code&gt;awaiter.await_suspend(current_handle)&lt;/code&gt;&lt;/b&gt;&lt;br/&gt;编译器先把当前协程暂停，然后把&lt;b&gt;当前正在被暂停的这个协程自己的 &lt;code&gt;handle&lt;/code&gt;&lt;/b&gt; 作为参数传进 &lt;code&gt;await_suspend&lt;/code&gt;！&lt;br/&gt;重点来了——&lt;code&gt;await_suspend&lt;/code&gt; 的&lt;b&gt;返回值类型&lt;/b&gt;有三种选择，如果你像 &lt;code&gt;task.h&lt;/code&gt; 里那样返回 &lt;b&gt;&lt;code&gt;std::coroutine_handle&amp;lt;&amp;gt;&lt;/code&gt;&lt;/b&gt;：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;这叫 &lt;b&gt;对称转移（Symmetric Transfer）&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;它的含义是告诉编译器：&lt;b&gt;“把我暂停之后，不要退回外层函数，请你立刻在底层直接调用我返回的那个 &lt;code&gt;handle.resume()&lt;/code&gt;！”&lt;/b&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;如果不想唤醒任何协程，就返回 &lt;code&gt;std::noop_coroutine()&lt;/code&gt;（一个什么都不干的空句柄），控制权就会乖乖退回给外层调用者。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;第三步：&lt;code&gt;awaiter.await_resume()&lt;/code&gt;&lt;/b&gt;&lt;br/&gt;等将来某一天，当前协程被别人重新唤醒（&lt;code&gt;resume&lt;/code&gt;）后，第一件事就是执行 &lt;code&gt;await_resume()&lt;/code&gt;，它的返回值就是 &lt;code&gt;int x = co_await ...&lt;/code&gt; 最终拿到的那个 &lt;code&gt;x&lt;/code&gt;。&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="240" width="720" x="1770" y="280" as="geometry" />
        </mxCell>
        <mxCell id="OXK-8gH5WVhAA4JB6ljA-1" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Awaiter&lt;div&gt;&lt;b&gt;&lt;code&gt;Awaiter&lt;/code&gt; 管的是 &lt;code&gt;co_await&lt;/code&gt; 这个“暂停动作”&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="250" x="2790" y="150" as="geometry" />
        </mxCell>
        <mxCell id="OXK-8gH5WVhAA4JB6ljA-2" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;在协程里你不一定总是 co_await 另一个 Task，你以后还会写：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await Sleep(100ms);（暂停当前协程，去等一个定时器）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await RpcAwaiter(...);（暂停当前协程，去发一个网络包，等收到回复再醒）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await Child();（暂停当前协程，去跑另一个子协程 Child）&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="370" x="2730" y="220" as="geometry" />
        </mxCell>
        <mxCell id="OXK-8gH5WVhAA4JB6ljA-3" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;为了统一所有这些五花八门的暂停行为，C++ 规定：不管你在 co_await 后面放什么东西，它都必须提供一个叫 Awaiter 的“暂停插头”，回答编译器的固定三问：&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;1. await_ready()：结果现在就有了吗？（返回 false = 没有，赶紧把当前协程暂停！）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;2. await_suspend(被暂停者的指针)：我已经把当前协程暂停了，他的指针传给你，你接下来要干嘛？（去设闹钟？去发网络包？还是去启动别的协程？）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;3. await_resume()：当前协程终于被重新唤醒了，把结果交出来吧！&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="430" x="2700" y="290" as="geometry" />
        </mxCell>
        <mxCell id="Um9zlV3WmmvOEePBqXCS-1" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="终点挂起&lt;div&gt;当协程走到final_suspend() 它自己的业务代码已经100%执行完毕了&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="3460" y="150" as="geometry" />
        </mxCell>
        <mxCell id="Um9zlV3WmmvOEePBqXCS-3" parent="WXZXG9LCmnDOXK58-rso-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;span&gt;在 C++20 标准中，停在 &lt;code&gt;final_suspend&lt;/code&gt; 的协程处于 &lt;code&gt;done() == true&lt;/code&gt;（已完成）状态&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;。C++ 规定：&lt;b&gt;绝对禁止对已经走到 &lt;code&gt;final_suspend&lt;/code&gt; 的协程再次调用 &lt;code&gt;resume()&lt;/code&gt;&lt;/b&gt;，只需要对它调用 &lt;code&gt;destroy()&lt;/code&gt; 释放堆内存即可&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;。&lt;/span&gt;&lt;div&gt;这里之所以要用 &lt;code&gt;await_ready() { return false; }&lt;/code&gt; 把它挂起，唯一的目的就是&lt;b&gt;踩住刹车、保住它的“尸体”（协程帧内存不自动释放）&lt;/b&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="390" x="3395" y="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="N4QDmQ10EfSS1L5nwb7n" name="协程代码流程">
    <mxGraphModel dx="4006" dy="1752" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GGXrj3e_NGOrfab0X-q7-1" parent="1" style="swimlane;html=1;startSize=160;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="协程代码流程" vertex="1">
          <mxGeometry height="1470" width="5770" x="-950" y="70" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-5" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="GGXrj3e_NGOrfab0X-q7-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KoIqALE1E5pkAQWu7fLO-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GGXrj3e_NGOrfab0X-q7-2" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;Task&amp;lt;int&amp;gt; Child() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; co_return 100;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Task&amp;lt;void&amp;gt; Parent() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int v = co_await Child(); // 👈 我们追踪这一行发生了什么！&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; co_return;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;int main() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Task&amp;lt;void&amp;gt; p = Parent(); &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;// 【第1步】&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; p.Start();&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// 【第2步】&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="178" width="320" x="50" y="680" as="geometry" />
        </mxCell>
        <mxCell id="GGXrj3e_NGOrfab0X-q7-4" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;编译器在堆上分配 Child 的协程帧，调用 Task&amp;lt;int&amp;gt;::promise_type::get_return_object()（第 80 行），创建一个握着 child_handle 的临时 Task&amp;lt;int&amp;gt; 对象。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;紧接着执行编译器插入的 co_await promise.initial_suspend()（第 17 行）：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;std::suspend_always initial_suspend() noexcept { return {};}&lt;/div&gt;&lt;div&gt;std::suspend_always 的意思是“永远挂起”。所以 Child 里的 co_return 100 根本还没执行，Child 就立刻停在函数开头，把这个临时的 Task&amp;lt;int&amp;gt; 对象返回给了 Parent。&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="470" x="500" y="818" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-3" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;Awaiter operator co_await() &amp;amp;&amp;amp;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (started_) {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; throw std::logic_error(&quot;cannot co_await a Task that was already started&quot;);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; started_ = true;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return Awaiter(std::exchange(handle_, nullptr));&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="1132.5" y="818" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-8" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="KoIqALE1E5pkAQWu7fLO-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KoIqALE1E5pkAQWu7fLO-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-4" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="调用 &lt;code&gt;Child()&lt;/code&gt; —— 创建协程帧，但立刻踩刹车&lt;div&gt;当 &lt;code&gt;Parent&lt;/code&gt; 执行到 &lt;code&gt;co_await Child()&lt;/code&gt; 时，首先调用 &lt;code&gt;Child()&lt;/code&gt; 函数：&lt;/div&gt;" vertex="1">
          <mxGeometry height="64" width="240" x="615" y="737" as="geometry" />
        </mxCell>
        <mxCell id="cctA4WoYWPuR92AUJUDd-2" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="KoIqALE1E5pkAQWu7fLO-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KoIqALE1E5pkAQWu7fLO-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-6" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;h3&gt;触发 &lt;code&gt;operator co_await()&lt;/code&gt; —— 转移所有权（防提前析构）&lt;/h3&gt;&lt;p&gt;现在表达式变成了 &lt;code&gt;co_await 临时Task对象&lt;/code&gt;。编译器会自动调用&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="335" x="1160" y="729" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-7" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;li&gt;&lt;p&gt;&lt;b&gt;这里有个极其精妙的细节&lt;/b&gt;：为什么要写 &lt;code&gt;std::exchange(handle_, nullptr)&lt;/code&gt; 把 &lt;code&gt;handle_&lt;/code&gt; 从 &lt;code&gt;Task&lt;/code&gt; 里掏空，塞给 &lt;code&gt;Task::Awaiter&lt;/code&gt;？&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;因为 &lt;code&gt;Child()&lt;/code&gt; 返回的 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 是个临时对象，马上就要析构了！如果不把 &lt;code&gt;handle_&lt;/code&gt; 拿走，&lt;code&gt;~Task()&lt;/code&gt; 就会执行 &lt;code&gt;handle_.destroy()&lt;/code&gt; 把还没跑的 &lt;code&gt;Child&lt;/code&gt; 当场销毁。所以这里把 &lt;code&gt;child_handle&lt;/code&gt; 的所有权移交给了 &lt;code&gt;Task::Awaiter&lt;/code&gt;。&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="1137.5" y="945" as="geometry" />
        </mxCell>
        <mxCell id="KfzAsVv4IUfwGEBz4FTw-1" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="KoIqALE1E5pkAQWu7fLO-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="7FQBF6eYViPQVhf6vbQs-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KoIqALE1E5pkAQWu7fLO-9" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;h3&gt;&lt;code&gt;Task::Awaiter&lt;/code&gt; 三步握手 —— &lt;code&gt;Parent&lt;/code&gt; 挂起，无缝切入 &lt;code&gt;Child&lt;/code&gt;&lt;/h3&gt;&lt;h3&gt;&lt;p&gt;拿到 &lt;code&gt;Task::Awaiter&lt;/code&gt; 后，编译器开始对它执行前面讲的“三步握手”&lt;/p&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="80" width="335" x="1820" y="729" as="geometry" />
        </mxCell>
        <mxCell id="cctA4WoYWPuR92AUJUDd-1" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;1. await_ready()：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;bool await_ready() const noexcept {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return handle_ == nullptr || handle_.done();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Child 刚刚在开头挂起，还没跑完（done() 为 false），所以返回 false，代表 Parent 必须挂起。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. await_suspend(continuation)：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;std::coroutine_handle&amp;lt;&amp;gt; await_suspend(std::coroutine_handle&amp;lt;&amp;gt; continuation) noexcept {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; handle_.promise().SetContinuation(continuation);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return handle_;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;参数 continuation 是编译器传进来的 父协程 Parent 自己的句柄。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;第一行：handle_.promise().SetContinuation(continuation) 把 Parent 的句柄存进 Child 的 promise.continuation_ 里（相当于 Child 记下了：“等我跑完，我要负责叫醒 Parent”）。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;第二行：return handle_; 返回 Child 自己的句柄！触发对称转移——编译器把 Parent 挂起后，立刻叫醒 Child 开始跑！&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="217" width="537.5" x="1718.75" y="828" as="geometry" />
        </mxCell>
        <mxCell id="FLpkhn8aeEDQalKP7TRV-2" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="7FQBF6eYViPQVhf6vbQs-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="FLpkhn8aeEDQalKP7TRV-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7FQBF6eYViPQVhf6vbQs-1" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;h3&gt;&lt;code&gt;Child&lt;/code&gt; 跑完 &lt;code&gt;co_return 100&lt;/code&gt;，通过 &lt;code&gt;FinalAwaiter&lt;/code&gt; 切回 &lt;code&gt;Parent&lt;/code&gt;&lt;/h3&gt;&lt;h3&gt;&lt;p&gt;&lt;code&gt;Child&lt;/code&gt; 被叫醒后，终于开始跑函数体里的 &lt;code&gt;co_return 100;&lt;/code&gt;&lt;/p&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="80" width="335" x="2540" y="729" as="geometry" />
        </mxCell>
        <mxCell id="7FQBF6eYViPQVhf6vbQs-2" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;调用 promise.return_value(100)（第 86 行），把 100 存进 Child 的 promise.value_ 中。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Child 走到函数末尾，撞上编译器插入的最后一刀：co_await promise.final_suspend()（第 39 行），进入 FinalAwaiter（第 22~37 行）：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;struct FinalAwaiter&amp;nbsp;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bool await_ready() const noexcept { return false; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; template &amp;lt;typename Promise&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; std::coroutine_handle&amp;lt;&amp;gt; await_suspend(std::coroutine_handle&amp;lt;Promise&amp;gt; handle) const noexcept {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const std::coroutine_handle&amp;lt;&amp;gt; continuation = handle.promise().continuation_;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return continuation != nullptr ? continuation : std::noop_coroutine();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; void await_resume() const noexcept {}&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="217" width="480" x="2467.5" y="828" as="geometry" />
        </mxCell>
        <mxCell id="7FQBF6eYViPQVhf6vbQs-3" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;为什么 await_ready() 必须返回 false（死前强制挂起）？&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果返回 true（不挂起），Child 彻底结束，编译器会自动 delete 掉 Child 的协程帧！那里面刚存好的返回值 100 就瞬间灰飞烟灭了，Parent 待会儿去拿就会发生 Use-After-Free（读野内存）。所以必须返回 false，让 Child 停在“尸体还在、但标记为 done()”的状态。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_suspend 交接棒：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;此时参数 handle 是 Child 自己。它去自己的 promise 里翻出第 3 步存好的 continuation_（也就是 Parent 的句柄），然后 return continuation;。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;再次触发对称转移！Child 挂起在终点，编译器立刻唤醒 Parent！&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="537.5" x="2438.75" y="1068" as="geometry" />
        </mxCell>
        <mxCell id="ev2R9FaUmyl3dQekCzNN-1" edge="1" parent="GGXrj3e_NGOrfab0X-q7-1" source="FLpkhn8aeEDQalKP7TRV-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Ng4-YqKWpKpnhi-pxdZY-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FLpkhn8aeEDQalKP7TRV-1" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;h3&gt;&lt;code&gt;Parent&lt;/code&gt; 醒来，取走返回值 &lt;code&gt;100&lt;/code&gt; 并超度 &lt;code&gt;Child&lt;/code&gt;&lt;/h3&gt;&lt;h3&gt;&lt;p&gt;&lt;code&gt;Parent&lt;/code&gt; 醒来后，继续完成第 3 步未完成的“三步握手”的最后一步——调用 &lt;code&gt;Task::Awaiter::await_resume()&lt;/code&gt;&lt;/p&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="89" width="335" x="3450" y="724.5" as="geometry" />
        </mxCell>
        <mxCell id="FLpkhn8aeEDQalKP7TRV-3" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;T await_resume() {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (handle_ == nullptr) {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; throw std::logic_error(&quot;co_await on an empty Task&quot;);&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return handle_.promise().TakeValue();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="460" x="3387.5" y="888" as="geometry" />
        </mxCell>
        <mxCell id="FLpkhn8aeEDQalKP7TRV-4" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;TakeValue()（第 91 行）先调用 RethrowIfNeeded()：如果刚才 Child 内部抛了异常，这里就会在 Parent 里面把异常重新 throw 出来（实现了跨协程的异常传递！）。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果没异常，就把 value_ 里的 100 std::move 出来，赋值给 Parent 的 int v。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;int v = co_await Child(); 整行语句执行完毕！临时对象 Task::Awaiter 生命周期结束，触发析构函数 ~Awaiter()（第 192 行）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;~Awaiter()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; if (handle_ != nullptr) {&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; handle_.destroy(); // 👈 在这里把停在终点的 Child 协程帧安全释放！&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="472.5" x="3381.25" y="948" as="geometry" />
        </mxCell>
        <mxCell id="Ng4-YqKWpKpnhi-pxdZY-1" parent="GGXrj3e_NGOrfab0X-q7-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;p&gt;我们用 &lt;b&gt;A 代表 &lt;code&gt;Parent&lt;/code&gt; 的协程帧&lt;/b&gt;，&lt;b&gt;B 代表 &lt;code&gt;Child&lt;/code&gt; 的协程帧&lt;/b&gt;，把从 &lt;code&gt;main&lt;/code&gt; 开始到结束的每一步钉死：&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;&lt;code&gt;main&lt;/code&gt; 调用 &lt;code&gt;Task&amp;lt;void&amp;gt; p = Parent();&lt;/code&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;创建 &lt;b&gt;协程帧 A&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;A 执行 &lt;code&gt;initial_suspend()&lt;/code&gt;（&lt;code&gt;await_ready&lt;/code&gt; 为 &lt;code&gt;false&lt;/code&gt;），&lt;b&gt;A 在函数开头暂停&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;返回 &lt;code&gt;Task&lt;/code&gt; 对象 &lt;code&gt;p&lt;/code&gt;（持有 A 的指针）给 &lt;code&gt;main&lt;/code&gt; 函数。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;&lt;code&gt;main&lt;/code&gt; 调用 &lt;code&gt;p.Start();&lt;/code&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;内部调用 &lt;code&gt;A.resume()&lt;/code&gt;，&lt;b&gt;A 第一次醒来&lt;/b&gt;，进入 &lt;code&gt;Parent&lt;/code&gt; 函数体，开始执行 &lt;code&gt;int v = co_await Child();&lt;/code&gt; 的&lt;b&gt;前半截&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 调用 &lt;code&gt;Child()&lt;/code&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;创建 &lt;b&gt;协程帧 B&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;B 执行 &lt;code&gt;initial_suspend()&lt;/code&gt;，&lt;b&gt;B 在函数开头暂停&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;返回一个临时的 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt;（持有 B 的指针）给 A。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 执行 &lt;code&gt;co_await&lt;/code&gt; 的前半截（进入 &lt;code&gt;Task&amp;lt;int&amp;gt;::Awaiter&lt;/code&gt;）&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;触发 &lt;code&gt;operator co_await()&lt;/code&gt;：把 &lt;b&gt;B 的指针&lt;/b&gt; 从临时 &lt;code&gt;Task&amp;lt;int&amp;gt;&lt;/code&gt; 中掏出来，塞进临时对象 &lt;b&gt;&lt;code&gt;awaiter&lt;/code&gt;&lt;/b&gt; 里（此时 &lt;b&gt;&lt;code&gt;awaiter&lt;/code&gt; 由 A 创建，保存在 A 的协程帧里，但里面握着的是 B 的指针&lt;/b&gt;）。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;调用 &lt;code&gt;awaiter.await_ready()&lt;/code&gt;：因为 B 还没跑完，返回 &lt;code&gt;false&lt;/code&gt;，代表 &lt;b&gt;A 需要暂停&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 在当前位置暂停&lt;/b&gt;，调用 &lt;code&gt;awaiter.await_suspend(A)&lt;/code&gt;：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;把 &lt;b&gt;A 的指针&lt;/b&gt; 存进 &lt;b&gt;B 的 &lt;code&gt;promise.continuation_&lt;/code&gt;&lt;/b&gt; 里。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;code&gt;return B;&lt;/code&gt;（触发对称转移，直接唤醒 B）。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;B 醒来并跑完全程&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;B 第一次醒来&lt;/b&gt;，执行 &lt;code&gt;co_return 100;&lt;/code&gt;，把 &lt;code&gt;100&lt;/code&gt; 存进 &lt;b&gt;B 的 &lt;code&gt;promise.value_&lt;/code&gt;&lt;/b&gt; 里。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;B 走到函数末尾的 &lt;code&gt;co_await B.promise.final_suspend()&lt;/code&gt;（进入 &lt;code&gt;FinalAwaiter&lt;/code&gt;）：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;code&gt;FinalAwaiter::await_ready()&lt;/code&gt; 返回 &lt;code&gt;false&lt;/code&gt;，&lt;b&gt;B 在终点线暂停（尸体保留，不销毁）&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;调用 &lt;code&gt;FinalAwaiter::await_suspend(B)&lt;/code&gt;：从 B 的 &lt;code&gt;promise.continuation_&lt;/code&gt; 里取出 &lt;b&gt;A 的指针&lt;/b&gt;，然后 &lt;code&gt;return A;&lt;/code&gt;（触发对称转移，直接唤醒 A）。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 第二次醒来，走完 &lt;code&gt;int v = co_await Child();&lt;/code&gt; 的后半截&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 在刚才暂停的地方醒来&lt;/b&gt;，立刻执行后半截：&lt;code&gt;v = awaiter.await_resume()&lt;/code&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;code&gt;await_resume()&lt;/code&gt; 去 &lt;b&gt;B 的 &lt;code&gt;promise.value_&lt;/code&gt;&lt;/b&gt; 里把 &lt;code&gt;100&lt;/code&gt; 拿出来，赋值给 A 的局部变量 &lt;code&gt;v&lt;/code&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;code&gt;int v = co_await Child();&lt;/code&gt; 这一整行语句终于执行完毕！临时对象 &lt;code&gt;awaiter&lt;/code&gt; 析构（&lt;code&gt;~Awaiter()&lt;/code&gt;），调用 &lt;code&gt;B.destroy()&lt;/code&gt;，&lt;b&gt;协程帧 B 在此刻被彻底销毁！&lt;/b&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 走到下一行 &lt;code&gt;co_return;&lt;/code&gt; 并结束&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;A 执行 &lt;code&gt;co_return;&lt;/code&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;A 走到函数末尾的 &lt;code&gt;co_await A.promise.final_suspend()&lt;/code&gt;：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;A 在终点线暂停（尸体保留）&lt;/b&gt;。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;调用 &lt;code&gt;FinalAwaiter::await_suspend(A)&lt;/code&gt;：去查 A 的 &lt;code&gt;promise.continuation_&lt;/code&gt;，发现是空的（&lt;code&gt;nullptr&lt;/code&gt;），于是返回 &lt;code&gt;std::noop_coroutine()&lt;/code&gt;（不唤醒任何协程，退回给当初调用 &lt;code&gt;p.Start()&lt;/code&gt; 的 &lt;code&gt;main&lt;/code&gt; 函数）。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;&lt;code&gt;main&lt;/code&gt; 函数结束&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;控制权回到 &lt;code&gt;main&lt;/code&gt; 函数的 &lt;code&gt;p.Start();&lt;/code&gt; 下一行。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;code&gt;main&lt;/code&gt; 函数大括号结束，局部变量 &lt;code&gt;p&lt;/code&gt; 析构（&lt;code&gt;~Task()&lt;/code&gt;），调用 &lt;code&gt;A.destroy()&lt;/code&gt;，&lt;b&gt;协程帧 A 被彻底销毁&lt;/b&gt;！&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="800" width="1000" x="4330" y="369" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
