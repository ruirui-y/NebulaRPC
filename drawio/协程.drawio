          <mxGeometry height="320" width="348.6" x="1172.8000000000002" y="2289" as="geometry" />
        </mxCell>
        <mxCell id="bxAfhXx4_2qBe2Fr6FQH-19" parent="bxAfhXx4_2qBe2Fr6FQH-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;收到 Request 请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;HandleCoroutineRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;根据 method_name 找到 CoroutineService::Method&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 Request 对象并反序列化请求数据&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;记录 request_id / trace_id，in_flight + 1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 RpcServerContext&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;调用 DispatchCoroutineRequest(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 DetachedTask coroutine frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DetachedTask::initial_suspend() = suspend_never&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 立即开始执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await method-&amp;gt;invoke(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 invoke 对应的 Task&amp;lt;unique_ptr&amp;lt;Message&amp;gt;&amp;gt; coroutine frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 挂起，执行权切换到 invoke 协程&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="303.22" x="1195.49" y="1419" as="geometry" />
        </mxCell>
        <mxCell id="aUTfipGi3IzDbRh3pCUC-1" edge="1" parent="bxAfhXx4_2qBe2Fr6FQH-1" source="bxAfhXx4_2qBe2Fr6FQH-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bxAfhXx4_2qBe2Fr6FQH-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bxAfhXx4_2qBe2Fr6FQH-20" parent="bxAfhXx4_2qBe2Fr6FQH-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="&lt;b&gt;co_await method-&amp;gt;invoke(...)&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;DispatchCoroutineRequest挂起&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="200" x="1867.1000000000001" y="1365" as="geometry" />
        </mxCell>
        <mxCell id="aUTfipGi3IzDbRh3pCUC-3" edge="1" parent="bxAfhXx4_2qBe2Fr6FQH-1" source="bxAfhXx4_2qBe2Fr6FQH-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="aUTfipGi3IzDbRh3pCUC-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bxAfhXx4_2qBe2Fr6FQH-22" parent="bxAfhXx4_2qBe2Fr6FQH-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;收到 Request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;HandleCoroutineRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;查找对应 CoroutineService::Method&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 Request + RpcServerContext&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;调用 DispatchCoroutineRequest(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 DispatchCoroutineRequest coroutine frame + promise_type&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DetachedTask::initial_suspend() = suspend_never&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 立即开始执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;执行：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await method-&amp;gt;invoke(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;调用 method-&amp;gt;invoke(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 invoke coroutine frame + promise_type&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke::initial_suspend() = suspend_always&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 挂起并返回 Task&amp;lt;unique_ptr&amp;lt;Message&amp;gt;&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task::operator co_await()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke.handle 从 Task 转移到 Task::Awaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Awaiter::await_ready() == false&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Awaiter::await_suspend(DispatchCoroutineRequest.handle)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke.promise.continuation = DispatchCoroutineRequest.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;return invoke.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;symmetric transfer 到 invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 开始执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;完成 Request 类型转换&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;执行：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await (*shared_handler)(context, *typed_request)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;调用 shared_handler(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 handler coroutine frame + promise_type&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler::initial_suspend() = suspend_always&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler 挂起并返回 Task&amp;lt;EchoResponse&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task::operator co_await()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler.handle 从 Task 转移到 Task::Awaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Awaiter::await_ready() == false&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Awaiter::await_suspend(invoke.handle)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler.promise.continuation = invoke.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;return handler.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;symmetric transfer 到 handler&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler 开始执行真正的 Echo 业务逻辑&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;构造 EchoResponse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_return response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler.promise.return_value(response)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EchoResponse 保存到 handler.promise&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler.promise.final_suspend()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 FinalAwaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter::await_ready() == false&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler 最终挂起，done() == true&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter::await_suspend(handler.handle)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;读取 handler.promise.continuation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;return invoke.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;symmetric transfer 回 invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler 的 Task::Awaiter::await_resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从 handler.promise 取出 EchoResponse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;完成：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Response response = co_await shared_handler(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler 的 Task::Awaiter 析构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler.handle.destroy()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handler coroutine frame + promise_type 销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 继续执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_return std::make_unique&amp;lt;Response&amp;gt;(std::move(response))&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke.promise.return_value(unique_ptr&amp;lt;Message&amp;gt;)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;返回值保存到 invoke.promise&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke.promise.final_suspend()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 FinalAwaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter::await_ready() == false&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 最终挂起，done() == true&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter::await_suspend(invoke.handle)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;读取 invoke.promise.continuation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;return DispatchCoroutineRequest.handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;symmetric transfer 回 DispatchCoroutineRequest&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 的 Task::Awaiter::await_resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从 invoke.promise 取出 unique_ptr&amp;lt;Message&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;完成：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response = co_await method-&amp;gt;invoke(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke 的 Task::Awaiter 析构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke.handle.destroy()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;invoke coroutine frame + promise_type 销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 继续执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;判断 response 是否为空&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;正常则 SendResponse(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;异常则进入对应 catch → SendError(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest 执行到函数末尾&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DetachedTask::promise_type::return_void()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DetachedTask::final_suspend()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;final_suspend() = suspend_never&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;不再挂起，也没有父协程需要恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DispatchCoroutineRequest coroutine frame + promise_type 自动销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;本次服务端协程请求处理结束&lt;/b&gt;&lt;/div&gt;" vertex="1">
