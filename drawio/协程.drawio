        </mxCell>
        <mxCell id="PRxtO9OpUCMDE1o3NtNJ-1" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="320" width="288.75" x="4810.63" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="PRxtO9OpUCMDE1o3NtNJ-2" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="380" width="435.85" x="4737.08" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="PRxtO9OpUCMDE1o3NtNJ-4" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;TaskPromiseBase::FinalAwaiter final_suspend()&lt;/b&gt;&lt;div&gt;&lt;b&gt;然后&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;bool await_ready() 执行挂起&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;到&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;std::coroutine_handle&amp;lt;&amp;gt; await_suspend&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="259.38" x="4825.31" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="86g3q3CEsntpWZOQ1ITZ-3" edge="1" parent="Z54ZfVYnGr8Ari6tvrVl-1" source="PRxtO9OpUCMDE1o3NtNJ-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="86g3q3CEsntpWZOQ1ITZ-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PRxtO9OpUCMDE1o3NtNJ-6" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="协程执行到 &lt;code dir=&quot;ltr&quot;&gt;final_suspend()&lt;/code&gt; 后会再次挂起，此时协程逻辑已经执行完毕，&lt;code dir=&quot;ltr&quot;&gt;done() == true&lt;/code&gt;，但 coroutine frame 尚未销毁，而是停留在 &lt;code dir=&quot;ltr&quot;&gt;FinalAwaiter&lt;/code&gt; 对应的最终挂起点。对于顶层 &lt;code dir=&quot;ltr&quot;&gt;Task&lt;/code&gt;，该 frame 会一直保留到 &lt;code dir=&quot;ltr&quot;&gt;Task&lt;/code&gt; 生命周期结束，由 &lt;code dir=&quot;ltr&quot;&gt;Task&lt;/code&gt; 析构时调用 &lt;code dir=&quot;ltr&quot;&gt;handle.destroy()&lt;/code&gt;，此时 &lt;code dir=&quot;ltr&quot;&gt;FinalAwaiter&lt;/code&gt;、&lt;code dir=&quot;ltr&quot;&gt;promise_type&lt;/code&gt; 以及整个 coroutine frame 一并销毁。" vertex="1">
          <mxGeometry height="76.97" width="325" x="5395" y="1246.02" as="geometry" />
        </mxCell>
        <mxCell id="86g3q3CEsntpWZOQ1ITZ-1" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;co_return 0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;结果写入 promise&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;final_suspend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter 创建&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;协程进入“执行完毕但 frame 保留”状态&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;main 调 task.Result() 读取结果&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task 生命周期结束&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task::~Task()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;handle.destroy()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;整个 RunEcho coroutine frame 销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;promise_type / FinalAwaiter 一起消失&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="210" x="5445" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="86g3q3CEsntpWZOQ1ITZ-2" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;完整流程&lt;/b&gt;" vertex="1">
          <mxGeometry height="23.98" width="60" x="6185" y="1272.51" as="geometry" />
        </mxCell>
        <mxCell id="86g3q3CEsntpWZOQ1ITZ-4" parent="Z54ZfVYnGr8Ari6tvrVl-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;创建 RunEcho coroutine frame + promise_type + Task&amp;lt;int&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;initial_suspend() → RunEcho 首次挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;task.Start() → handle.resume() → RunEcho 开始执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await stub.Call(...) → 创建 RpcResultAwaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_ready() == false → await_suspend() → 保存 RunEcho handle，发起 RPC，RunEcho 挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RPC 完成 → 恢复 RunEcho&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_resume() → 得到 RpcResult&amp;lt;EchoResponse&amp;gt; → RpcResultAwaiter 析构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;继续执行 result 后面的业务逻辑&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_return 0 → promise.return_value(0)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;final_suspend() → 创建 FinalAwaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FinalAwaiter::await_ready() == false → RunEcho 最终挂起，done() == true&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;顶层 Task 没有 continuation → 返回 std::noop_coroutine()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;task.Result() 读取 promise 中的返回值&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task 生命周期结束&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Task::~Task() → handle.destroy()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;销毁 FinalAwaiter、promise_type 和整个 RunEcho coroutine frame&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="470" x="5980" y="1320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
