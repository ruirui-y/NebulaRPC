        <mxCell id="CXk7qCbLeuDR9p2oK2AG-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="协程测试客户端：协程是如何运行的？" vertex="1">
