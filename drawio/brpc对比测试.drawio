        <mxCell id="aiBalRajXrNotsoR2B2T-1" parent="aiBalRajXrNotsoR2B2T-9" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;Channel::CallMethod()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── 获取 Controller 的 call_id&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── 保存 request/response/done&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── 配置协议、重试策略、连接类型&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── SerializeRpcRequest()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── bthread_timer_add()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp; &amp;nbsp;└── 注册 RPC 超时定时器&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; └── Controller::IssueRPC()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="352" width="329.37" x="730" y="288" as="geometry" />
        </mxCell>
        <mxCell id="aiBalRajXrNotsoR2B2T-4" parent="aiBalRajXrNotsoR2B2T-9" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;Controller::IssueRPC()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── 获取目标 Socket&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── 根据 connection_type 选择发送连接&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; ├── PackRpcRequest()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp; &amp;nbsp;└── 将序列化消息封装为 baidu_std 数据包&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; │&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; └── Socket::Write()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;&lt;span style=&quot;font-size: 10px; color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; └── 将数据送入 TCP 发送路径&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="329.37" x="730" y="720" as="geometry" />
        </mxCell>
