          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-16" edge="1" parent="IWCHLpxbpcDbyYtTjn6W-1" source="IWCHLpxbpcDbyYtTjn6W-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="IWCHLpxbpcDbyYtTjn6W-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-17" edge="1" parent="IWCHLpxbpcDbyYtTjn6W-1" source="IWCHLpxbpcDbyYtTjn6W-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="IWCHLpxbpcDbyYtTjn6W-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-2" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="核心测试场景" vertex="1">
          <mxGeometry height="35.74327956989247" width="129.1695777210912" x="90.0030518140608" y="1085.8499103942652" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-13" edge="1" parent="IWCHLpxbpcDbyYtTjn6W-1" source="IWCHLpxbpcDbyYtTjn6W-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="IWCHLpxbpcDbyYtTjn6W-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-4" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="单连接 / 少连接 Ping-Pong 延迟测试（测框架基础链路开销）" vertex="1">
          <mxGeometry height="47.65770609318997" width="287.0435060468693" x="534.9204861867082" y="573.5295698924731" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-72" edge="1" parent="IWCHLpxbpcDbyYtTjn6W-1" source="IWCHLpxbpcDbyYtTjn6W-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="IWCHLpxbpcDbyYtTjn6W-71">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-5" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;测试配置：并发线程数 = 1，连接数 = 1，Payload 大小 = 64 Bytes，连续发送 10 万次请求。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;核心观测指标：平均延迟 (Avg Latency)、P99 / P999 尾延迟、单线程 QPS。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;倒逼 NebulaRPC 的技术点：&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;如果单线程延迟比 bRPC 高很多，检查你的 Socket 是否忘记开启 TCP_NODELAY（禁用 Nagle 算法，否则小包会被憋 40ms 才发！）。&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;检查你的 Reactor 跨线程唤醒机制（比如 MainReactor 分发给 SubReactor 或工作线程池时，是用 eventfd 还是条件变量锁？有没有多余的上下文切换？）。&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190.6308243727599" width="574.0870120937386" x="929.6053070011535" y="502.04301075268813" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-7" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="高并发小包极限 QPS 压测（测 IO 线程模型与锁竞争）" vertex="1">
          <mxGeometry height="47.65770609318997" width="287.0435060468693" x="534.9204861867082" y="871.3902329749104" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-8" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;测试配置：Payload 固定为 128 Bytes 或 512 Bytes（确保不触碰千兆网卡带宽上限），逐步拉高客户端并发线程/协程数：1 -&amp;gt; 4 -&amp;gt; 8 -&amp;gt; 16 -&amp;gt; 32 -&amp;gt; 64 -&amp;gt; 128。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;核心观测指标：画出 “并发数 - QPS 曲线” 和 “并发数 - P99 延迟曲线”。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;💡 倒逼 NebulaRPC 的技术点：&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;序列化与反序列化位置：Protobuf 的 SerializeToString / ParseFromArray 是在 IO 线程做的还是业务线程池做的？&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;队列锁竞争：如果多个 IO 线程往同一个业务线程池任务队列里塞请求，那把 std::mutex 就会成为最大的性能杀手（倒逼你改造成无锁队列或按线程 Hash 分发）。&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;连接模式：你的客户端是每次请求都共用一个连接池，还是支持单连接多路复用（Multiplexing，通过 Request ID 异步匹配响应）？如果客户端还在用“一请求一同步阻塞等回包”，并发根本拉不起来！&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250.20295698924733" width="574.0870120937386" x="922.4292193499818" y="835.6469534050179" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-9" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="不同 Payload 大小吞吐量测试（测内存池与零拷贝 Buffer）" vertex="1">
          <mxGeometry height="47.65770609318997" width="287.0435060468693" x="534.9204861867082" y="1264.566308243728" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-10" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;测试配置：Payload 固定为 128 Bytes 或 512 Bytes（确保不触碰千兆网卡带宽上限），逐步拉高客户端并发线程/协程数：1 -&amp;gt; 4 -&amp;gt; 8 -&amp;gt; 16 -&amp;gt; 32 -&amp;gt; 64 -&amp;gt; 128。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;核心观测指标：画出 “并发数 - QPS 曲线” 和 “并发数 - P99 延迟曲线”。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;💡 倒逼 NebulaRPC 的技术点：&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;当包变大（如 16KB ~ 64KB）时，bRPC 依靠独创的 butil::IOBuf（非连续零拷贝环形/链式缓冲），拼装协议头和切分粘包时几乎没有 memcpy。&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;如果你的 NebulaRPC 用的是连续内存 std::vector&amp;lt;char&amp;gt; 或 std::string 来做应用层 Buffer，并且存在多次 string 拷贝，大包测试时你的 CPU 会瞬间飙到 100%，&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;且吞吐量卡在三四十 MB/s 上不去（用 perf top 一抓，全是 __memmove_avx_unaligned_erms）。这会直接倒逼你优化 Buffer 的 readv/writev（分散读/聚集写）和减少内存拷贝！&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="238.28853046594983" width="574.0870120937386" x="929.6053070011535" y="1181.1653225806451" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-11" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="长尾延迟与高负载稳定性压测（测抗压能力与内存泄漏）" vertex="1">
          <mxGeometry height="47.65770609318997" width="287.0435060468693" x="534.9204861867082" y="1514.769265232975" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-12" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;测试配置：开启 32 并发，持续压测 5 ~ 10 分钟。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;核心观测指标：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;P99 / P999 延迟毛刺（99.9% 的请求在多少毫秒内完成）。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Server 进程的 RES 物理内存占用是否平稳（排查内存泄漏或缓冲区无限膨胀）。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;压测结束后再跑一次低并发请求，看性能能否瞬间恢复。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="154.88754480286735" width="574.0870120937386" x="929.6053070011535" y="1479.0259856630826" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-18" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;h3 style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;bRPC 本机回环（&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;127.0.0.1&lt;/code&gt;）基准测试数据汇总&lt;/h3&gt;&lt;ul style=&quot;padding-inline-start: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p id=&quot;p-rc_7ff154cd2ba6ad0c-109&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;测试环境&lt;/b&gt;：Ubuntu 22.04 虚拟机（8 核 vCPU / 16GB 内存）&lt;/span&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;sup class=&quot;superscript&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important; font-size: 16px !important; background-color: transparent !important;&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;，Release 编译模式（&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;-O2&lt;/code&gt;/&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;-O3&lt;/code&gt;）&lt;/span&gt;   &lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;CPU 绑核隔离策略&lt;/b&gt;：Server 独占 &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;0-3&lt;/code&gt; 核（4 核），Client 独占 &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;4-7&lt;/code&gt; 核（4 核）&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="95.31541218637994" width="674.552239210143" x="1893.3166856765288" y="69.9978494623656" as="geometry" />
        </mxCell>
        <mxCell id="IWCHLpxbpcDbyYtTjn6W-71" parent="IWCHLpxbpcDbyYtTjn6W-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;【bRPC 本机基准实测数据 (Server: 0-3核 | Client: 4-7核)】&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;1. 单连接 Ping-Pong 基准 (1线程, 64B):&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 实测单线程 QPS: 稳定 4,800 ~ 5,360 QPS (峰值 5,534)&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 实测平均延迟 (Avg Latency): 178 ~ 206 us (均值 ~195 us / 0.195 ms)&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 基线结论: 在 VMware 虚拟化环境下，单次完整 RPC 往返（序列化 + 2次内核态 loopback 转发 + epoll/bthread 唤醒 + 反序列化）的物理底噪约为 195 微秒。&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;2. 高并发吞吐基准 (16线程, 1KB):&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 实测并发 QPS: 稳定 41,200 ~ 42,400 QPS (峰值 42,433)&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 实测平均延迟 (Avg Latency): 374 ~ 393 us (均值 ~380 us / 0.38 ms)&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp; &amp;nbsp;• 基线结论: 并发拉升 16 倍、包体扩大 16 倍后，QPS 提升了约 8.2 倍，而平均延迟仅增加不到 1 倍（从 195us 到 380us），体现了 bRPC 无锁队列与 M:N 协程极强的抗高并发能力。&lt;/font&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="313.2311827956989" width="796.44" x="1860" y="440.7451612903226" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
