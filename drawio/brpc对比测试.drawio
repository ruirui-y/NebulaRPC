          <mxGeometry height="190" width="360.93" x="9305.89" y="776.5" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-38" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="继续向上寻找平台&amp;nbsp;增加单连接协程数&lt;div&gt;256 / 512 各重复 3 次&lt;/div&gt;" vertex="1">
          <mxGeometry height="32" width="185" x="9408.69" y="1020" as="geometry" />
