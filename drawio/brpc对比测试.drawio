        <mxCell id="1" parent="0" />
        <mxCell id="KCpi0DZ4Thzh07qEkEmV-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="NebulaRPC-测试链路" vertex="1">
          <mxGeometry height="1570" width="1960" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="zQrJBrLR55SpoBLv1rAd-4" edge="1" parent="KCpi0DZ4Thzh07qEkEmV-1" source="KCpi0DZ4Thzh07qEkEmV-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KCpi0DZ4Thzh07qEkEmV-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KCpi0DZ4Thzh07qEkEmV-2" parent="KCpi0DZ4Thzh07qEkEmV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="NebulaRPC-测试链路" vertex="1">
          <mxGeometry height="33" width="120" x="40" y="546" as="geometry" />
        </mxCell>
        <mxCell id="zQrJBrLR55SpoBLv1rAd-3" edge="1" parent="KCpi0DZ4Thzh07qEkEmV-1" source="KCpi0DZ4Thzh07qEkEmV-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="zQrJBrLR55SpoBLv1rAd-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RZE6p3Cbbe0liETDmd2a-2" edge="1" parent="KCpi0DZ4Thzh07qEkEmV-1" source="KCpi0DZ4Thzh07qEkEmV-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="RZE6p3Cbbe0liETDmd2a-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KCpi0DZ4Thzh07qEkEmV-4" parent="KCpi0DZ4Thzh07qEkEmV-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;main(argc, argv)：程序入口&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;ParseOptions()：解析命令行参数并检查合法性&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;SharedStart + Stats：创建启动同步对象与统计容器&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;std::thread × workers：按照 workers 参数创建多个工作线程，并分配请求数量&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Worker::Run()：每个工作线程创建独立的 EventLoop、RpcChannel、Stub，并启动事件循环&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Probe() → Warmup()：检测 RPC 连接是否可用，执行预热请求&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;WaitForStart() → Pump()：等待全部工作线程准备完成，统一开始计时并发送 RPC 请求&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Pump() → stub_.Echo()：根据 window 控制在途请求数量，通过异步 RPC 发起请求&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;RpcChannel::CallMethod()：执行 RPC 客户端调用，进入框架的请求发送链路&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;RpcClosure → QueueInLoop()：RPC 完成后触发回调，将后续处理投递到当前 Worker 的 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;OnDone() → Pump()：处理响应、统计延迟和请求结果，继续补充新的 RPC 请求&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;EventLoop::Quit()：当前 Worker 完成目标请求数量后退出事件循环&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Report()：汇总所有 Worker 的统计数据，计算 QPS、平均延迟、P50/P95/P99/P999、失败数及超时数&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="315" width="500" x="585" y="405" as="geometry" />
        </mxCell>
        <mxCell id="KCpi0DZ4Thzh07qEkEmV-6" edge="1" parent="KCpi0DZ4Thzh07qEkEmV-1" source="KCpi0DZ4Thzh07qEkEmV-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="KCpi0DZ4Thzh07qEkEmV-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KCpi0DZ4Thzh07qEkEmV-5" parent="KCpi0DZ4Thzh07qEkEmV-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;服务端测试命令&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;taskset -c 0-3 /home/yjj/.vs/NebulaRPC/build/linux-release/bin/nebula_rpc_echo_benchmark_server 9000 0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;客户端测试命令&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;taskset -c 4-7 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;./nebula_rpc_echo_benchmark_client \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --host 127.0.0.1 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --port 9000 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --workers 16 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --window 1 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --requests 600000 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --payload-bytes 128 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --warmup-requests 100 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --timeout-ms 2000 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --max-seconds 120 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; --csv nebula_round2_128B.csv&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="375" x="647.5" y="150" as="geometry" />
        </mxCell>
        <mxCell id="zQrJBrLR55SpoBLv1rAd-1" parent="KCpi0DZ4Thzh07qEkEmV-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;rpc_echo_benchmark_server::main()：程序入口，解析监听端口和 IO 线程数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop + RpcServer + EchoServiceImpl：创建事件循环、RPC 服务端和 Echo 业务服务&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::RegisterService()：注册 EchoService，将服务名称与服务对象保存到映射表&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::Start() → TcpServer::Start()：启动 TCP 服务端，监听端口并初始化 IO 线程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop::Loop()：进入事件循环，等待客户端连接和网络事件&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;TcpServer::NewConnection()：接受客户端连接，创建 TcpConnection 并绑定消息回调&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;TcpConnection::HandleRead() → RpcServer::OnMessage()：读取 TCP 数据到接收缓冲区，进入 RPC 消息处理&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcCodec::Decode()：从接收缓冲区解码完整 RPC 帧，处理半包和粘包&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::OnMessage()：识别消息类型，将 REQUEST 请求交给 HandleRequest，继续处理剩余完整帧&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::HandleRequest()：根据 service_name 和 method_name 查找已注册的服务及方法&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ServerCall + ParseFromString()：创建请求和响应对象，将 RPC Payload 反序列化为 Protobuf 请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Service::CallMethod()：根据 MethodDescriptor 调用对应的业务方法&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EchoServiceImpl::Echo()：读取请求中的 text，写入响应 text，并设置 server_sequence&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;done-&amp;gt;Run() → RpcServer::SendResponse()：业务处理完成，触发回调并开始构造 RPC 响应&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcCodec::Encode() → TcpConnection::Send()：序列化响应并编码 RPC 帧，通过 TCP 连接发送给客户端&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::OnCallFinished()：减少服务端在途 RPC 计数，完成本次请求处理&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="385" width="610" x="530" y="775" as="geometry" />
        </mxCell>
        <mxCell id="RZE6p3Cbbe0liETDmd2a-1" parent="KCpi0DZ4Thzh07qEkEmV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="NebulaRPC-测试链路" vertex="1">
          <mxGeometry height="33" width="120" x="1440" y="546" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="a7d49esdyZjUJ4oyEnXu" name="server火焰图对比分析">
    <mxGraphModel dx="1334" dy="486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="server火焰图对比分析" vertex="1">
          <mxGeometry height="1980" width="11590" x="-80" y="140" as="geometry" />
        </mxCell>
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-7" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="XtTi8q-D5o0nLRHlOBfs-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="XtTi8q-D5o0nLRHlOBfs-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-4" parent="XtTi8q-D5o0nLRHlOBfs-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="320" width="367.11" x="40" y="449.27" as="geometry" />
        </mxCell>
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-8" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="XtTi8q-D5o0nLRHlOBfs-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="XtTi8q-D5o0nLRHlOBfs-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-5" parent="XtTi8q-D5o0nLRHlOBfs-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="344.47" width="367.11" x="40" y="949.27" as="geometry" />
        </mxCell>
        <mxCell id="WZNuLy3mMxcG_YMtLyH8-2" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="XtTi8q-D5o0nLRHlOBfs-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WZNuLy3mMxcG_YMtLyH8-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XtTi8q-D5o0nLRHlOBfs-6" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;纵轴：从下往上看 是一整条函数调用链&lt;/b&gt;&lt;div&gt;&lt;b&gt;main -&amp;gt; EventLoop::Loop -&amp;gt; Channel::HandleEvent -&amp;gt; RpcServer::OnMessage -&amp;gt; RpcServer::HandleRequest -&amp;gt; RpcServer::SendResponse -&amp;gt; TcpConnection::Send -&amp;gt; __libc_send&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;横轴：占总CPU时间的比例&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每一行的宽度代表着占用了多少百分比的CPU 越宽说明CPU在这个路径上花的时间越多&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;山顶：如果只有头顶上再也没有其他盒子，才代表perf采样的一瞬间，CPU真正正在执行的指令&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果山顶是尖的：说明到底层后，耗时分散在很多小步骤里，没有单一卡点&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果山顶是宽平的：说明CPU有大量的真实时间全都卡死在最顶上那个函数干活&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="535" x="585" y="849.27" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-2" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="WZNuLy3mMxcG_YMtLyH8-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="nYhsuw-eU27te0mirDey-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WZNuLy3mMxcG_YMtLyH8-1" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;【破局思考：如何吃满 4 个核，同时消灭“锁 + 线程切换 + 系统调用”三大开销？】&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;一、 纠偏时间账（为什么单核会卡在 5.1 万 QPS）：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. RTT (0.2ms = 200us) 是包在整条链路往返的总时间，不是服务端 CPU 处理时间！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. 服务端单核处理 1 个 128B 请求的真实耗时约为 15~20 us：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;• 其中纯用户态（拆包 + Protobuf + Echo）仅需 ~1.5 us（占 10%）；&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;• 剩下的 ~14 us 全花在每次请求单独调一次 __libc_send 系统调用上（占 90%）！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. 所以 1 秒 (1,000,000 us) ÷ 19 us ≈ 5.1 万 QPS —— 这就是单核逐包系统调用的物理死穴！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;二、 为什么不能用传统的“单 IO 线程 + 3 业务线程池”？&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;• Echo 业务本身只需 0.2 us，但跨线程投递（加锁 + 唤醒 + QueueInLoop + write eventfd）高达 10 us。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;• 铁律：当【业务耗时 &amp;lt; 跨线程调度开销】时，引入传统线程池然后投递回 IO 线程发包，属于负优化！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;三、 真正的两条工业级破局路线（NebulaRPC vs bRPC 哲学对比）：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;路线 A：bRPC 哲学 —— 【单连接 + 拆散读写绑定 + 原地无锁代写 (Wait-Free Write)】&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;bRPC 之所以敢只用 1 条连接还开 9 个线程，是因为它打破了 Muduo“只能在所属 EventLoop 线程发包”的铁律：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. 读包切块后直接并发：IO 线程 1 次 readv 读出缓冲区里的一串包，按帧切开后，直接交给各个工作线程并行反序列化和执行 Echo。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. 谁处理完谁直接发（不投递回原 IO 线程！）：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;工作线程执行完 Echo 后，【绝不】调用 QueueInLoop 投递回原线程！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;而是直接调用 Socket::Write：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;• 如果当前没人正在写这个 Socket，当前工作线程直接原地调 writev 发包！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;• 如果正好有别的线程在写，当前线程仅用 1 次 CAS 原子操作把包挂在 Socket 的无锁链表头，立刻转身去干别的活（0 阻塞、0 锁等待），由正在写的那个线程顺手用 1 次 writev 帮大家一起批量发掉！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;路线 B：NebulaRPC (One Loop Per Thread) 哲学 —— 【4 连接分摊 4 核 + 单 Loop 内读写批处理】&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果不重写底层的无锁 Socket，在现有的 One Loop Per Thread 架构下，最纯粹的满分解法是：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. 用“4 条连接”代替“线程池分发”：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;开启 io_threads = 4，客户端建立 4 条连接。Linux 内核与 Acceptor 天然将 4 条连接分给 4 个 EventLoop 线程。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;每个核各自独占 1 条连接，【从根源上消灭跨线程锁和线程切换】！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. 在单个 EventLoop 内做“读批处理 + 写合并 (Flush)”：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;当缓冲区里有几十个包时，1 次 readv 全部读入 -&amp;gt; while 循环在用户态一口气跑完这几十个包的解码与 Echo -&amp;gt; 响应只追加到 output_buffer_ 不调 send -&amp;gt; 循环结束时，统一调 1 次 send/writev 把几十个响应一次性推进内核！&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;（将 20 次系统调用压缩为 1 次，单核直接从 5 万 QPS 突破至 15 万+ QPS！）&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="427.5" width="840" x="1200" y="700.52" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-4" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="nYhsuw-eU27te0mirDey-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="nYhsuw-eU27te0mirDey-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-1" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;网关：少量 I/O 线程管理大量外部连接。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;内部 RPC：少量 I/O 线程管理少量长连接，每条连接多路复用大量 RPC；业务并发尽量交给协程。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CPU 密集型业务再使用多个工作线程并行执行。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="280" x="2180" y="884.27" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-8" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="nYhsuw-eU27te0mirDey-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="nYhsuw-eU27te0mirDey-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OTsnid5R4kJDhYIxgbEp-5" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="nYhsuw-eU27te0mirDey-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="OTsnid5R4kJDhYIxgbEp-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-3" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;优化方向：减少连接带来的系统调用比如send和recv&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;减少线程带来的上下文切换成本 只有4个核但是多线程会发生CPU资源抢占行为&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;架构设计：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;内部RPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;客户端：&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;4 个线程&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;4 个 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;4 条 TCP 长连接&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;每条连接跑 16 个协程 / 16 个 in-flight RPC&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;总并发 = 64&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;服务端：&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;1 个 base EventLoop 负责 accept&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;4 个 IO EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;4 条长连接分别分配给 4 个 IO EventLoop&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="226.65" width="320" x="2540" y="800.95" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-7" connectable="0" parent="XtTi8q-D5o0nLRHlOBfs-1" style="group" value="" vertex="1">
          <mxGeometry height="349.65" width="260" x="3170" y="220" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-5" parent="nYhsuw-eU27te0mirDey-7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;批量读&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;input_buffer_.ReadFd(socket_.Fd(), &amp;amp;saved_errno)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;一次性读64kb 所以批量读的功能是有的 从火焰图也能看到读系统调用占据CPU的时间比较少&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="260" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-6" parent="nYhsuw-eU27te0mirDey-7" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="289.65" width="260" y="60" as="geometry" />
        </mxCell>
        <mxCell id="OTsnid5R4kJDhYIxgbEp-11" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="OTsnid5R4kJDhYIxgbEp-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="OTsnid5R4kJDhYIxgbEp-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OTsnid5R4kJDhYIxgbEp-2" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;OnMessage 一次处理当前 Buffer 中所有完整 RPC Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;处理过程中只生成并收集 Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当 Decode 返回 kNeedMore 后&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;统一把本轮所有 Response 合并发送&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;新路径：Response Batch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;HandleRead()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;readv()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;RpcServer::OnMessage()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;创建本轮 ResponseBatch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;while Decode()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;REQ1 → HandleRequest → RESP1 → Batch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;REQ2 → HandleRequest → RESP2 → Batch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;REQ3 → HandleRequest → RESP3 → Batch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;REQ4 → HandleRequest → RESP4 → Batch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;...&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Decode == kNeedMore&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;结束本轮 OnMessage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;ResponseBatch::Flush()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;conn-&amp;gt;Send(RESP1 + RESP2 + RESP3 + RESP4 + ...)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;SendInLoop()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;尽可能一次 ::send()&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="417.5" width="290" x="3630" y="974.54" as="geometry" />
        </mxCell>
        <mxCell id="OTsnid5R4kJDhYIxgbEp-4" connectable="0" parent="XtTi8q-D5o0nLRHlOBfs-1" style="group" value="" vertex="1">
          <mxGeometry height="803.29" width="260" x="3170" y="660" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-9" parent="OTsnid5R4kJDhYIxgbEp-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;批量写&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;我们每一次send都会主动调用一次系统调用而不是让loop关注写事件进行批量写&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="260" as="geometry" />
        </mxCell>
        <mxCell id="nYhsuw-eU27te0mirDey-10" parent="OTsnid5R4kJDhYIxgbEp-4" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="203.29" width="260" y="40" as="geometry" />
        </mxCell>
        <mxCell id="OTsnid5R4kJDhYIxgbEp-3" parent="OTsnid5R4kJDhYIxgbEp-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;旧路径：Immediate Send&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;HandleRead()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;readv()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::OnMessage()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;while Decode()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;HandleRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Service::CallMethod()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;done-&amp;gt;Run()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SendResponse()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;TcpConnection::Send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SendInLoop()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;::send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;问题：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;虽然一次 readv 可以读入多个完整 RPC 请求，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;但是每处理完一个请求都会立即调用一次 Send。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;REQ1 → RESP1 → send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;REQ2 → RESP2 → send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;REQ3 → RESP3 → send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;REQ4 → RESP4 → send()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;所以读可以批量，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写仍然基本是“一条 RPC 一次 send syscall”。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;火焰图中大量 CPU 时间因此落在：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;__libc_send&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;sys_sendto&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;tcp_sendmsg&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;TCP/IP 协议栈&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="260" y="243.28999999999996" as="geometry" />
        </mxCell>
