        <mxCell id="OTsnid5R4kJDhYIxgbEp-8" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;重新跑1-128并发测试&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;测试环境：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;128B Payload&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;127.0.0.1 Loopback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Client CPU 4~7&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Server CPU 0~3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Client：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 OS Thread&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 TCP Connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每连接运行 window 个 Coroutine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Server：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 IO Thread&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer ResponseBatch&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CMD测试命令：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;服务端：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;taskset -c 0-3 \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;/home/yjj/.vs/NebulaRPC/build/linux-release/bin/nebula_rpc_echo_benchmark_server \&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;9000 4&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;客户端：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;scp nebula_coroutine_batch_128B.sh yjj@192.168.31.62:/home/yjj/&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;chmod +x /home/yjj/nebula_coroutine_batch_128B.sh&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;/home/yjj/nebula_coroutine_batch_128B.sh&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="445" x="4310" y="986.5" as="geometry" />
        </mxCell>
