        </mxCell>
        <mxCell id="nJOrJLbN9f6KK1yd6LTg-1" parent="6pl94vqOCZvLNI8e0LVM-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;echo &#39;{&quot;message&quot;:&quot;hello world&quot;}&#39; &amp;gt; ~/brpc/example/echo_c++/requests.json&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;~/brpc/build/output/bin/rpc_press \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -proto ~/brpc/example/echo_c++/echo.proto \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -server 127.0.0.1:8000 \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -input ~/brpc/example/echo_c++/requests.json \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -qps 1000 \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -duration 20 \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; -thread_num 4&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="35" y="727" as="geometry" />
        </mxCell>
        <mxCell id="nJOrJLbN9f6KK1yd6LTg-2" parent="6pl94vqOCZvLNI8e0LVM-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;rpc_press 使用 pthread_create() 启动 4 个压测发送线程。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;目标总发送速率是 1000 QPS，每个发送线程按约 250 QPS 控制发送节奏。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;rpc_press 在这个模式下发起的是异步 RPC，并不是每个线程发送一条请求后必须等待响应才能发送下一条。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;协议默认是 baidu_std，不是 HTTP。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;测试持续约 20 秒后停止发压；目标 QPS 不代表实际成功 QPS。&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="370" x="55" y="875" as="geometry" />
        </mxCell>
