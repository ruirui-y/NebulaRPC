<mxfile host="Electron" pages="9">
  <diagram id="KSj8qRheXDKA0lQuJ5w8" name="测试电脑网络吞吐上限">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="测试电脑网络吞吐上限" vertex="1">
          <mxGeometry height="1560" width="4150" x="-880" y="-70" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-15" edge="1" parent="KyTEPL8TXpAWPMXPdxUC-1" source="KyTEPL8TXpAWPMXPdxUC-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KyTEPL8TXpAWPMXPdxUC-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-2" parent="KyTEPL8TXpAWPMXPdxUC-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="环境配置" vertex="1">
          <mxGeometry height="35" width="140" x="222.5" y="485" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-5" parent="KyTEPL8TXpAWPMXPdxUC-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;h3&gt;宿主机端（运行 VMware 的 Windows 电脑）&lt;/h3&gt;&lt;p id=&quot;p-rc_76140256ab105a47-226&quot;&gt;&lt;span&gt;关闭 Realtek 2.5G 物理网卡&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt; 的硬件卸载（RSC/LSO），防止物理网卡把数据包强行拼成超大包导致 VMware 桥接驱动丢包&lt;/span&gt;&lt;/p&gt;&lt;p id=&quot;p-rc_76140256ab105a47-226&quot;&gt;&lt;span&gt;Start-Process powershell -Verb RunAs -ArgumentList &#39;-Command &quot;Disable-NetAdapterRsc -Name &#39;&#39;以太网&#39;&#39; -ErrorAction SilentlyContinue; Disable-NetAdapterLso -Name &#39;&#39;以太网&#39;&#39;&quot;&#39;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="445" x="70" y="545" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-6" parent="KyTEPL8TXpAWPMXPdxUC-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;h3&gt;VMware 虚拟机硬件配置&lt;/h3&gt;&lt;h3&gt;&lt;p id=&quot;p-rc_76140256ab105a47-227&quot;&gt;&lt;span&gt;将桥接网卡（网络适配器 2）&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt; 的模拟驱动从老旧的 &lt;code&gt;e1000&lt;/code&gt; 升级为高性能半虚拟化驱动&lt;/span&gt;&lt;/p&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;在虚拟机处于&lt;span&gt;关机&lt;/span&gt;状态时，用记事本打开虚拟机目录下的 &lt;code&gt;.vmx&lt;/code&gt; 配置文件，确保包含以下配置&lt;/font&gt;&lt;/span&gt;&lt;/h3&gt;&lt;h3&gt;ethernet1.virtualDev = &quot;vmxnet3&quot;&lt;br&gt;&lt;p id=&quot;p-rc_76140256ab105a47-227&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="120" width="445" x="70" y="685" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-7" parent="KyTEPL8TXpAWPMXPdxUC-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="178" width="204" x="70" y="815" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-8" parent="KyTEPL8TXpAWPMXPdxUC-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(237, 237, 237), rgb(255, 255, 255));&quot;&gt;右键Ubuntu 64位 打开虚拟机目录&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="26" width="180" x="285" y="869" as="geometry" />
        </mxCell>
        <mxCell id="KyTEPL8TXpAWPMXPdxUC-9" parent="KyTEPL8TXpAWPMXPdxUC-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;h3&gt;Ubuntu 虚拟机内部网络与路由配置&lt;/h3&gt;&lt;h3&gt;&lt;p id=&quot;p-rc_76140256ab105a47-228&quot;&gt;&lt;span&gt;开机后，确保 NAT 网卡（&lt;code&gt;ens33&lt;/code&gt;）与桥接网卡（&lt;code&gt;ens160&lt;/code&gt;）各司其职&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;：&lt;/span&gt;&lt;/p&gt;&lt;p id=&quot;p-rc_76140256ab105a47-228&quot;&gt;&lt;span&gt;详情配置参考Unbutu网卡设置.io&lt;/span&gt;&lt;/p&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="100" width="445" x="70" y="1035" as="geometry" />
        </mxCell>
