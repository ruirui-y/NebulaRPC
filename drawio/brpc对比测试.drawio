        <mxCell id="IWCHLpxbpcDbyYtTjn6W-19" parent="IWCHLpxbpcDbyYtTjn6W-25" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
