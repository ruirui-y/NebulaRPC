          <mxGeometry height="170" width="414.96" x="5037.5" y="906.5" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-5" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;1. 旧模型通过增加线程和连接提高 RPC 并发，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;在 32~128 并发附近吞吐长期停留在约 5 万 QPS。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. 新模型固定 4 条 TCP 长连接，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;通过单连接多 RPC in-flight + Coroutine 提高逻辑并发。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. 服务端 ResponseBatch 将同一次 OnMessage 中产生的多个同步响应合并，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;减少了逐 RPC 立即 send 的机会。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4. 在 total_inflight = 64：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;旧 Nebula ≈ 49.8k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;bRPC ≈ 144.9k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;新 Nebula ≈ 325.0k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5. 在 total_inflight = 128：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;新 Nebula ≈ 404.3k QPS，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;是旧版约 8.42 倍，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;是 bRPC Async 约 2.88 倍。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;6. 当 total_inflight 从 256 增加到 512：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;QPS 基本保持在 429.7k~429.8k，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;Avg 延迟从 588us 增长到 1177us。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;说明当前测试配置已经进入明显的吞吐饱和区，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;继续增加在途请求只会主要增加排队和延迟。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="520" x="5537.5" y="716.5" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-10" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="2HHmdJ9FWSOreIBX8fXe-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="avZBT7V6Cw8DNxa5gLh0-9">
          <mxGeometry relative="1" as="geometry" />
