        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-21" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="avZBT7V6Cw8DNxa5gLh0-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="avZBT7V6Cw8DNxa5gLh0-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-9" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="把批处理能力下沉到 TcpConnection" vertex="1">
          <mxGeometry height="32" width="190" x="7510" y="855.5" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-12" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;实验结果证明服务端批处理发送是有效的 但是客户端还是一次send一次系统调用 所以将批处理发送内化成通用能力&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="220" x="7495" y="910" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-13" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;上层决定：&lt;/div&gt;&lt;div&gt;什么时候这一批数据结束&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;TcpConnection 决定：&lt;/div&gt;&lt;div&gt;如何缓存&lt;/div&gt;&lt;div&gt;如何真正发送&lt;/div&gt;&lt;div&gt;写不完以后如何处理&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;将Send()&lt;/div&gt;&lt;div&gt;SendInLoop()&lt;/div&gt;&lt;div&gt;改成&lt;/div&gt;&lt;div&gt;Write()&lt;/div&gt;&lt;div&gt;Flush()&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="125" x="7542.5" y="983" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-15" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;TcpConnection 新发送模型&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Write(data)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;只追加到 output_buffer_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;不主动执行 send syscall&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Flush()&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FlushInLoop()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;尝试发送整个 output_buffer_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;最终：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Write&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;=&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;产生待发送数据&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Flush&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;=&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;主动提交当前批次&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;HandleWrite&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;=&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Flush 无法一次完成后的 backpressure continuation&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="230" x="7920" y="400" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-17" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;RPCServer发送路径：&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;RpcServer::OnMessage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Decode REQ1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;HandleRequest&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Encode RESP1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;conn-&amp;gt;Write(RESP1)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Decode REQ2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;conn-&amp;gt;Write(RESP2)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Decode REQ3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;conn-&amp;gt;Write(RESP3)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;...&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;当前可解码完整帧处理完&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;conn-&amp;gt;Flush()&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="230" x="7920" y="716" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-19" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;RpcChannel / Client 同样使用新的机制&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;Coroutine1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CallMethod&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Write(REQ1)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine2&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CallMethod&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Write(REQ2)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CallMethod&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Write(REQ3)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;...&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前这一批请求准备完成&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Flush()&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="230" x="7920" y="1090" as="geometry" />
        </mxCell>
