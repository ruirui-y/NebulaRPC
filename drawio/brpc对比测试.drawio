        <mxCell id="avZBT7V6Cw8DNxa5gLh0-41" parent="XtTi8q-D5o0nLRHlOBfs-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="250" width="458.18" x="9305.89" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-42" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="window=1024，寻找真正平台" vertex="1">
          <mxGeometry height="22" width="141.31" x="9454.89" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-49" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="avZBT7V6Cw8DNxa5gLh0-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="avZBT7V6Cw8DNxa5gLh0-45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-43" parent="XtTi8q-D5o0nLRHlOBfs-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="120" width="495.61" x="9305.89" y="1482" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-51" edge="1" parent="XtTi8q-D5o0nLRHlOBfs-1" source="avZBT7V6Cw8DNxa5gLh0-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="avZBT7V6Cw8DNxa5gLh0-50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-45" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;【发送架构演进】&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;最早版本&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每个 RPC 直接 TcpConnection::Send&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;大量请求对应大量独立发送机会&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;旧 benchmark 峰值约 51k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;第一轮优化&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::ResponseBatch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Server 在一次 OnMessage 内聚合同步 Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;最高约 430k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;但 batching 只存在于 Server RPC 层&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;第二轮架构调整&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;移除 TcpConnection::Send / SendInLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;新增：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Write()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 只写 output_buffer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Flush()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 上层显式决定批次结束&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FlushInLoop()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 主动尝试排空 buffer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;HandleWrite()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 只负责 partial write / EAGAIN 后续写&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;批处理能力从 RpcServer 下沉 TcpConnection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Client Request 与 Server Response 共用同一发送机制&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;最终实测：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;512 inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;≈ 917k QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1024 inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;≈ 1.095M QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2048 inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;≈ 1.698M QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4096 inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;≈ 1.730M QPS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4096 时吞吐仅比 2048 增长约 1.9%，&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;但平均延迟几乎翻倍。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;因此当前测试条件下：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;稳定吞吐平台约为 1.7M QPS。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="760" width="430" x="10115" y="491.75" as="geometry" />
        </mxCell>
        <mxCell id="avZBT7V6Cw8DNxa5gLh0-50" parent="XtTi8q-D5o0nLRHlOBfs-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;1. Transport 层显式 Write/Flush 可以正确工作。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. Client / Server 都能够使用同一套 batching 机制。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. 旧约 430k 平台被突破。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4. 新平台约出现在 1.7M QPS。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5. 4096 in-flight 后继续增加并发的收益已经很低。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="123.5" width="430" x="10730" y="809.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
