        <mxCell id="wSFWzHIId-WUcVcLLjZ1-17" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="测试示例" vertex="1">
