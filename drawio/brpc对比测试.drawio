        <mxCell id="wSFWzHIId-WUcVcLLjZ1-7" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="git clone --depth 1 https://github.com/apache/brpc.git" vertex="1">
          <mxGeometry height="20" width="300" x="400" y="660" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-13" edge="1" parent="wSFWzHIId-WUcVcLLjZ1-1" source="wSFWzHIId-WUcVcLLjZ1-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="wSFWzHIId-WUcVcLLjZ1-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-8" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="编译brpc项目" vertex="1">
          <mxGeometry height="33" width="100" x="910" y="600" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-9" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cd ~/brpc&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ① 先确认站在源码根目录（应该看到 CMakeLists.txt / src / example）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;ls CMakeLists.txt src example&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ② 记下版本号 —— 写进你的测试记录，后面写文档/讲面试都要用&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;git log -1 --format=&quot;%H %ci&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ③ 配置&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cmake -B build \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; -DCMAKE_BUILD_TYPE=Release \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; -DCMAKE_PREFIX_PATH=/usr/local \&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; -DWITH_DEBUG_SYMBOLS=OFF&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ④ 编译（完整日志留一份，出错时回查）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cmake --build build -j6 2&amp;gt;&amp;amp;1 | tee build.log&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="360" x="780" y="670" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-16" edge="1" parent="wSFWzHIId-WUcVcLLjZ1-1" source="wSFWzHIId-WUcVcLLjZ1-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="wSFWzHIId-WUcVcLLjZ1-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-11" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="验证是否编译成功" vertex="1">
          <mxGeometry height="33" width="100" x="1330" y="600" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-12" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ① 产物到底有什么&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;ls build/output/lib/&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;ls build/output/bin/ | head -30&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ② 找 brpc 的库（.so 和 .a 都找）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;find build -name &quot;libbrpc*&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ③ ⭐ 验证 protobuf —— 静态链接时 ldd 看不见，所以直接查 CMakeCache 最可靠&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;grep -iE &quot;Protobuf_LIBRARY|Protobuf_INCLUDE|Protobuf_PROTOC&quot; build/CMakeCache.txt&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;# ④ 如果可执行文件是动态链接，拿它交叉验证&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;ldd build/output/bin/rpc_press | grep -iE &quot;protobuf|gflags|ssl&quot;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="360" x="1200" y="680" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-19" edge="1" parent="wSFWzHIId-WUcVcLLjZ1-1" source="wSFWzHIId-WUcVcLLjZ1-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="wSFWzHIId-WUcVcLLjZ1-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-14" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="编译示例程序" vertex="1">
          <mxGeometry height="33" width="100" x="1750" y="600" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-15" parent="wSFWzHIId-WUcVcLLjZ1-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cd ~/brpc/example/echo_c++&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/usr/local&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;cmake --build build -j6&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="340" x="1630" y="680" as="geometry" />
        </mxCell>
        <mxCell id="wSFWzHIId-WUcVcLLjZ1-21" edge="1" parent="wSFWzHIId-WUcVcLLjZ1-1" source="wSFWzHIId-WUcVcLLjZ1-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="wSFWzHIId-WUcVcLLjZ1-20">
          <mxGeometry relative="1" as="geometry" />
