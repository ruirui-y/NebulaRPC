        <mxCell id="9Fz6bAIcim4H4Dxhs74H-83" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;Coroutine Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;长期存在&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;│&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;├─ Request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;├─ Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;├─ Controller&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;├─ Awaiter Storage&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;├─ 当前执行位置&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;└─ 局部变量&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每一次 RPC：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;└─ new / make_shared RpcCoroutineCompletion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Awaiter：&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;每 RPC 构造&lt;/div&gt;&lt;div&gt;每 RPC 析构&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;但：&lt;/div&gt;&lt;div&gt;不等于每 RPC heap new Awaiter&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Awaiter 通常直接位于 Coroutine Frame 的存储空间中&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="270" x="4600" y="1923" as="geometry" />
        </mxCell>
