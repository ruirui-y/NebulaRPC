        <mxCell id="elcqbcRlNrFoHiUSS2mQ-2" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="测试" vertex="1">
          <mxGeometry height="33" width="40" x="290" y="529.5" as="geometry" />
        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-4" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;重新创建两套 Fixed-InFlight Client&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NebulaRPC：&lt;/div&gt;&lt;div&gt;4 Worker&lt;/div&gt;&lt;div&gt;4 EventLoop&lt;/div&gt;&lt;div&gt;4 RpcChannel&lt;/div&gt;&lt;div&gt;4 TCP Connection&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;bRPC：&lt;/div&gt;&lt;div&gt;4 Worker&lt;/div&gt;&lt;div&gt;4 Channel&lt;/div&gt;&lt;div&gt;4 独立 single TCP Connection&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;↓&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;统一使用：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;window = 每连接最大在途 RPC 数&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;total_inflight&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;= 4 × window&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;↓&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;统一扫描：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;window：&lt;/div&gt;&lt;div&gt;1 2 4 8 16 32 64 128 256 512 1024&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;total_inflight：&lt;/div&gt;&lt;div&gt;4 8 16 32 64 128 256 512&lt;/div&gt;&lt;div&gt;1024 2048 4096&lt;/div&gt;" vertex="1">
          <mxGeometry height="395" width="220" x="200" y="585" as="geometry" />
        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-14" edge="1" parent="elcqbcRlNrFoHiUSS2mQ-1" source="elcqbcRlNrFoHiUSS2mQ-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="elcqbcRlNrFoHiUSS2mQ-13">
