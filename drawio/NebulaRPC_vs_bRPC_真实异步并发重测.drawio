        <mxCell id="9Fz6bAIcim4H4Dxhs74H-32" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;普通函数调用后栈帧销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;为了等待异步结果，只能把状态搬到堆上：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CallContext&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ RpcClosure&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ lambda capture&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ shared_ptr&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ Cancel Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;异步完成后再通过回调把这些状态找回来&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="220" x="4600" y="673" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-39" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-37">
