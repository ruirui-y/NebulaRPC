        <mxCell id="elcqbcRlNrFoHiUSS2mQ-9" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="统一测试口径节点" vertex="1">
          <mxGeometry height="27.5" width="120" x="780" y="531.5" as="geometry" />
        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-11" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;统一测试参数&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Server CPU：&lt;/div&gt;&lt;div&gt;0-3&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Client CPU：&lt;/div&gt;&lt;div&gt;4-7&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Worker：&lt;/div&gt;&lt;div&gt;4&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;TCP Connection：&lt;/div&gt;&lt;div&gt;4&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Payload：&lt;/div&gt;&lt;div&gt;128 Bytes&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Requests：&lt;/div&gt;&lt;div&gt;100000&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Warmup：&lt;/div&gt;&lt;div&gt;100 / Worker&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RPC Timeout：&lt;/div&gt;&lt;div&gt;2000 ms&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Connect Timeout：&lt;/div&gt;&lt;div&gt;10000 ms&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Max Test Time：&lt;/div&gt;&lt;div&gt;60 s&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试模式：&lt;/div&gt;&lt;div&gt;Closed-loop Fixed-InFlight&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;每完成 1 个 RPC&lt;/div&gt;&lt;div&gt;立即补发 1 个 RPC&lt;/div&gt;&lt;div&gt;直到完成全部 Requests&lt;/div&gt;" vertex="1">
          <mxGeometry height="467.75" width="170" x="755" y="595" as="geometry" />
        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-12" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;OUTDIR=&quot;$HOME/rpc-bench/nebula_fixed_inflight_128B_$(date +%Y%m%d_%H%M%S)&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;mkdir -p &quot;$OUTDIR&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CSV=&quot;$OUTDIR/nebula_fixed_inflight_128B.csv&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;BIN=&quot;/home/yjj/.vs/NebulaRPC/build/linux-release/bin/nebula_rpc_echo_fixed_inflight_client&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;for window in 1 2 4 8 16 32 64 128 256 512 1024; do&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; inflight=$((4 * window))&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; log=&quot;$OUTDIR/window_${window}_inflight_${inflight}.log&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;============================================================&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;window=$window&amp;nbsp; total_inflight=$inflight&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;============================================================&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; taskset -c 4-7 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &quot;$BIN&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --host 127.0.0.1 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --port 9000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --workers 4 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --window &quot;$window&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --requests 100000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --payload-bytes 128 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --warmup-requests 100 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --timeout-ms 2000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --connect-timeout-ms 10000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --max-seconds 60 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --csv &quot;$CSV&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2&amp;gt;&amp;amp;1 | tee &quot;$log&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; sleep 1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo &quot;CSV : $CSV&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo &quot;LOG : $OUTDIR&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;cat &quot;$CSV&quot;&lt;/b&gt;&lt;/div&gt;" vertex="1">
