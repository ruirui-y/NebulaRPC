        <mxCell id="9Fz6bAIcim4H4Dxhs74H-132" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-130">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-138" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-134">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-111" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="Callback vs Coroutine 的性能证据" vertex="1">
          <mxGeometry height="29.5" width="175" x="5835" y="2390.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-122" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;普通栈帧销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;状态必须堆化&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Context + Closure + Cancel Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;回调恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每 RPC 重建状态&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine Frame 长期存在&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;状态保留在 Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每 RPC 只构造 Awaiter / Completion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;resume 原执行点&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;同一个 Lane 持续复用&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(204, 0, 102));&quot;&gt;Callback 每次 RPC 都需要重新构造更多外部异步状态、Closure、捕获对象；Coroutine 复用长期存在的 coroutine frame，因此生命周期管理和 allocator 压力更低&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="324.75" width="335" x="7070" y="2462.87" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-126" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-133">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="7090" y="2412.875" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-123" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="220" width="555.42" x="6240" y="1662.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-141" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-133">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-127" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="395.03" width="555.42" x="6240" y="1979.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-129" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="Coroutine 吞吐提升 &lt;strong&gt;8.26%&lt;/strong&gt;，Client CPU/RPC 降低 &lt;strong&gt;10.51%&lt;/strong&gt;，P99 降低 &lt;strong&gt;10.43%&lt;/strong&gt;，P999 降低 &lt;strong&gt;14.72%&lt;/strong&gt;" vertex="1">
          <mxGeometry height="20" width="450" x="6285" y="1949.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-139" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-133">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-130" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="324.75" width="557.95" x="6240" y="2529.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-131" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="Coroutine 最大的结构优势之一不是“协程切换神奇地更快”，而是&lt;strong&gt;减少了 Callback 模型中反复创建、捕获、释放异步状态对象造成的 allocator 压力和堆碎片整理成本&lt;/strong&gt;" vertex="1">
          <mxGeometry height="29.5" width="430" x="6295" y="2489.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-145" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-144">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-133" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="&lt;b&gt;Coroutine 的收益不是“网络层更快”，而是把 Callback 为跨异步边界而产生的多个短生命周期状态对象、回调对象和生命周期管理，收拢到长期存在的 Coroutine Frame + Awaiter 状态机中&lt;/b&gt;" vertex="1">
          <mxGeometry height="64" width="240" x="7117.5" y="2390.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-140" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-133">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-134" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="329.71" width="555.42" x="6240" y="2989.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-135" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="Coroutine 完成路径更短，去掉 RpcClosure 层，同时显著降低 QueueInLoop 控制流成本。" vertex="1">
          <mxGeometry height="20" width="410" x="6303.73" y="2949.15" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-147" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-146">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-144" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="530" width="658.39" x="7600" y="2157.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-150" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-146" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-149">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-146" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="从火焰图可以看到，syscall 热点主要集中在 TakePendingCall → CancelTimer 路径：取消定时器时，如果删除的是当前队首，就会重新设置 timerfd，从而触发 timerfd_settime 系统调用。" vertex="1">
          <mxGeometry height="64" width="240" x="8416" y="2390.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-148" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;因此改为 Lazy Cancel：取消定时器时只删除用户态记录，不立即重设 timerfd。旧 deadline 到期后允许一次 stale wakeup，再由 HandleRead 重新武装到新的最早 deadline。这样既避免了高频系统调用，也不会影响超时正确性。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="64" width="308" x="8382" y="2480" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-153" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-149" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-152">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-149" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="250" width="579.71" x="8870" y="2297.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-151" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;五行代码换来的收益&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="100" x="9109.85" y="2050" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-152" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="590" width="720.98" x="9590" y="2127.5" as="geometry" />
