        <mxCell id="9Fz6bAIcim4H4Dxhs74H-154" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="201" width="340.37" x="8989.67" y="2090" as="geometry" />
