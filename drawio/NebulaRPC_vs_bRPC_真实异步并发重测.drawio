        <mxCell id="9Fz6bAIcim4H4Dxhs74H-105" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;稳态阶段：&lt;/b&gt;&lt;div&gt;假设一次 OnMessage 收到 N 个 Response：&lt;/div&gt;&lt;div&gt;&lt;div&gt;OnMessage&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Response #1 → Queue Resume Lane1&lt;/div&gt;&lt;div&gt;Response #2 → Queue Resume Lane2&lt;/div&gt;&lt;div&gt;...&lt;/div&gt;&lt;div&gt;Response #N → Queue Resume LaneN&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;最后&lt;/div&gt;&lt;div&gt;→ Queue Flush&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop 后续：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;resume Lane1&lt;/div&gt;&lt;div&gt;→ while 下一轮&lt;/div&gt;&lt;div&gt;→ Write Request&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;resume Lane2&lt;/div&gt;&lt;div&gt;→ Write Request&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;...&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;resume LaneN&lt;/div&gt;&lt;div&gt;→ Write Request&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;最后执行 Flush&lt;/div&gt;&lt;div&gt;↓&lt;/div&gt;&lt;div&gt;一次发送 N 个新 Request&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="240" x="4600" y="3530" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-117" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-111">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-108" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="收到一批 Response → 唤醒对应 Lane → 各 Lane 补一个新请求 → 批末统一 Flush" vertex="1">
          <mxGeometry height="30" width="380" x="4912" y="3470" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-111" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="Callback vs Coroutine 的性能证据" vertex="1">
          <mxGeometry height="29.5" width="175" x="5835" y="2390.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-121" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="9Fz6bAIcim4H4Dxhs74H-120">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-118" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="180" width="529.44" x="6235" y="2315.25" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-119" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-118">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-120" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;b&gt;Coroutine 的收益不是“网络层更快”，而是把 Callback 为跨异步边界而产生的多个短生命周期状态对象、回调对象和生命周期管理，收拢到长期存在的 Coroutine Frame + Awaiter 状态机中&lt;/b&gt;" vertex="1">
          <mxGeometry height="44.75" width="295" x="6895" y="2382.88" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-122" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;普通栈帧销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;状态必须堆化&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Context + Closure + Cancel Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;回调恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每 RPC 重建状态&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Coroutine Frame 长期存在&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;状态保留在 Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每 RPC 只构造 Awaiter / Completion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;resume 原执行点&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;同一个 Lane 持续复用&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="274.75" width="305" x="6895" y="2455.25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
