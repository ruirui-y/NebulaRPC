        <mxCell id="d5J82jLf8-7w7FyrDe2I-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="重测目标与测试口径" vertex="1">
          <mxGeometry height="1145" width="2050" x="-470" y="10" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-10" edge="1" parent="d5J82jLf8-7w7FyrDe2I-1" source="d5J82jLf8-7w7FyrDe2I-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="QKTV2qPZ3TxR4xi7BWjy-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-12" edge="1" parent="d5J82jLf8-7w7FyrDe2I-1" source="d5J82jLf8-7w7FyrDe2I-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="QKTV2qPZ3TxR4xi7BWjy-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5J82jLf8-7w7FyrDe2I-2" parent="d5J82jLf8-7w7FyrDe2I-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;code&gt;重测原因&lt;/code&gt;" vertex="1">
          <mxGeometry height="33" width="60" x="350" y="535" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-14" edge="1" parent="d5J82jLf8-7w7FyrDe2I-1" source="QKTV2qPZ3TxR4xi7BWjy-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="QKTV2qPZ3TxR4xi7BWjy-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-9" parent="d5J82jLf8-7w7FyrDe2I-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;旧 bRPC Async 测试&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;使用异步 Callback API&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;但每个 Worker 只维持 1 个 in-flight RPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;REQ&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;等待 Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcDone&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;再发送下一条 REQ&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="205" x="615" y="365" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-15" edge="1" parent="d5J82jLf8-7w7FyrDe2I-1" source="QKTV2qPZ3TxR4xi7BWjy-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="QKTV2qPZ3TxR4xi7BWjy-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-11" parent="d5J82jLf8-7w7FyrDe2I-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;为什么旧结果不能直接用&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;旧“并发数”本质上是 Worker 数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;例如：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;workers = 64&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;≈ 64 条一发一收的 RPC 链&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;它不是：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;少量连接 + 固定多 in-flight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;因此旧数据不能直接用于&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;和新版 NebulaRPC 做公平对比&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="205" x="615" y="605" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-17" edge="1" parent="d5J82jLf8-7w7FyrDe2I-1" source="QKTV2qPZ3TxR4xi7BWjy-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="QKTV2qPZ3TxR4xi7BWjy-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-13" parent="d5J82jLf8-7w7FyrDe2I-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;code&gt;本轮重测&lt;/code&gt;" vertex="1">
          <mxGeometry height="33" width="60" x="970" y="535" as="geometry" />
        </mxCell>
        <mxCell id="QKTV2qPZ3TxR4xi7BWjy-16" parent="d5J82jLf8-7w7FyrDe2I-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;本轮重测要修正什么&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;不再把 Worker 数当作并发数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;统一使用：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;total_inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;bRPC：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;少量固定 Worker / Connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ 每条连接同时维持多个 in-flight RPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;NebulaRPC：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;使用相同 total_inflight&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;两边采用同一种&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Closed-loop Fixed-InFlight 模型&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="198.5" width="205" x="1150" y="452.25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
