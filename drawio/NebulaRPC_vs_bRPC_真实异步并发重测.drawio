        <mxCell id="9Fz6bAIcim4H4Dxhs74H-34" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;RunLane 是一个长期存在的 Coroutine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await 时函数并没有销毁&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;只是 suspend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;跨 suspend 需要保存的：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Controller&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Awaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;局部变量&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前执行位置&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;统一保存在 Coroutine Frame 中&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;完成后 resume 同一个 Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从 co_await 后继续执行&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="220" x="4600" y="953" as="geometry" />
        </mxCell>
