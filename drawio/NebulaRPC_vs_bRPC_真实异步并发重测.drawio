        <mxCell id="elcqbcRlNrFoHiUSS2mQ-5" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="NebulaRPC 测试命令" vertex="1">
          <mxGeometry height="27.5" width="120" x="1400" y="531.5" as="geometry" />
        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-7" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;Server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;taskset -c 0-3 \&lt;/div&gt;&lt;div&gt;/home/yjj/.vs/NebulaRPC/build/linux-release/bin/nebula_rpc_echo_coroutine_server \&lt;/div&gt;&lt;div&gt;9000 4&lt;/div&gt;" vertex="1">
