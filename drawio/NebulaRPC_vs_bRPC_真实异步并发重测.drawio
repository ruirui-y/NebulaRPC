        </mxCell>
        <mxCell id="elcqbcRlNrFoHiUSS2mQ-16" parent="elcqbcRlNrFoHiUSS2mQ-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;OUTDIR=&quot;$HOME/rpc-bench/brpc_fixed_inflight_128B_$(date +%Y%m%d_%H%M%S)&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;mkdir -p &quot;$OUTDIR&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CSV=&quot;$OUTDIR/brpc_fixed_inflight_128B.csv&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;BIN=&quot;/home/yjj/.vs/brpc/example/echo_c++/build/brpc_fixed_inflight_client&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;for window in 1 2 4 8 16 32 64 128 256 512 1024; do&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; inflight=$((4 * window))&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; log=&quot;$OUTDIR/window_${window}_inflight_${inflight}.log&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;============================================================&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;window=$window&amp;nbsp; total_inflight=$inflight&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; echo &quot;============================================================&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; taskset -c 4-7 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &quot;$BIN&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --server=127.0.0.1:8000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --workers=4 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --window=&quot;$window&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --requests=100000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --payload_bytes=128 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --warmup_requests=100 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --timeout_ms=2000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --connect_timeout_ms=10000 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --max_seconds=60 \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --protocol=baidu_std \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --connection_type=single \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; --csv=&quot;$CSV&quot; \&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2&amp;gt;&amp;amp;1 | tee &quot;$log&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; sleep 1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo &quot;CSV : $CSV&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;echo &quot;LOG : $OUTDIR&quot;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;cat &quot;$CSV&quot;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="467.75" width="475" x="1973" y="685" as="geometry" />
        </mxCell>
        <mxCell id="uw1qS13JULSmPmeDvfYa-2" edge="1" parent="elcqbcRlNrFoHiUSS2mQ-1" source="elcqbcRlNrFoHiUSS2mQ-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="uw1qS13JULSmPmeDvfYa-1">
