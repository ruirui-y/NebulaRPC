        <mxCell id="9Fz6bAIcim4H4Dxhs74H-9" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="测试协程" vertex="1">
          <mxGeometry height="33" width="70" x="1410" y="2419" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-14" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-11" parent="9Fz6bAIcim4H4Dxhs74H-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="380" width="602.68" x="1610" y="2245.5" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-13" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;p&gt;本轮测试固定使用 4 个 Worker、4 条 TCP 连接、128B Payload，测试窗口从 1 增加到 1024。将此前 A 组（旧协程压测客户端、当前原生协程内核、Callback Server）与本轮真正的 Callback Client 进行对比。&lt;/p&gt;&lt;p&gt;吞吐量方面： 本轮 Callback Client 在 11 个窗口下的 QPS 均低于 A 组。Window=1 时低约 6.95%；Window=4、8 时低约 21%；Window=32 时低约 26.18%；Window=256 时低约 27.29%；Window=512 时低约 39.93%；Window=1024 时低约 34.89%。随着并发窗口增大，两组的吞吐量差距整体上呈现扩大趋势，但并非严格单调变化。&lt;/p&gt;&lt;p&gt;延迟方面： 在低窗口下，Callback Client 的部分延迟指标更低。例如 Window=1 时，其 Avg、P50、P95、P99 和 P999 均低于 A 组。Window=2 时，P50、P95、P99 和 P999 也略低，但平均延迟更高。从 Window=32 开始，Callback Client 的平均延迟和大部分分位延迟逐渐高于 A 组；在 Window=128、256、512 和 1024 时，差异更加明显。Window=512 时，Callback Client 的 Avg 比 A 组高约 38.35%，P99 高约 55.50%。&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="520" x="2390" y="2358" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-20" edge="1" parent="9Fz6bAIcim4H4Dxhs74H-1" source="9Fz6bAIcim4H4Dxhs74H-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9Fz6bAIcim4H4Dxhs74H-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9Fz6bAIcim4H4Dxhs74H-15" parent="9Fz6bAIcim4H4Dxhs74H-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=0;fillColor=#dae8fc;strokeColor=#6c8ebf;points=[[0,0,1,0,0],[0.25,0,1,0,0],[0.5,0,1,0,0],[0.75,0,1,0,0],[1,0,1,0,0],[0,0.25,1,0,0],[0,0.5,1,0,0],[0,0.75,1,0,0],[1,0.25,1,0,0],[1,0.5,1,0,0],[1,0.75,1,0,0],[0,1,1,0,0],[0.25,1,1,0,0],[0.5,1,1,0,0],[0.75,1,1,0,0],[1,1,1,0,0],[0.333333,0.46875,0,0,0]];" value="测试并收集火焰图" vertex="1">
          <mxGeometry height="30" width="100" x="3080" y="2420.5" as="geometry" />
