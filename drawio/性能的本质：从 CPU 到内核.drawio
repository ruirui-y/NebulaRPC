  <diagram id="page_173e621f7459" name="CPU / 执行模型">
    <mxGraphModel dx="3006" dy="1752" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1570" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v_3a123e0f6065" parent="1" style="swimlane;html=1;startSize=32;fillColor=#fafafa;strokeColor=#888888;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="CPU / 执行模型" vertex="1">
