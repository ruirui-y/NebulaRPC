        <mxCell id="pg1" value="① 常用框样式 —— 左边拖走，右边是它的用途" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="655" as="geometry" />
        </mxCell>
        <mxCell id="p1note" value="用法：① 把左边的图形直接拖到你的画布；② 或选中 Ctrl+C → 切窗口 Ctrl+V；③ 想长期用就拖进左下「便签本」（随软件保存，这才是真正的默认样式）。&#xa;图形里的文字是占位符，替换即可；四类语义配色与「流程梳理_answer.drawio」完全一致。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pg1">
          <mxGeometry x="30" y="50" width="1760" height="50" as="geometry" />
