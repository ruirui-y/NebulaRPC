        <mxCell id="p5g0_n3" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="序列化失败要回 loop 线程再完成" vertex="1">
