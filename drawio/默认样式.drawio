        <mxCell id="p3n1a" value="起点框&#xa;file.cpp:NNN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg3">
          <mxGeometry x="930" y="187" width="170" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p3n1b" value="终点框&#xa;file.cpp:NNN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg3">
