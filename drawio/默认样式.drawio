        <mxCell id="p5g0_s4" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="⑤ 打 rpc call start 结构化日志&#xa;rpc_channel.cpp:246" vertex="1">
          <mxGeometry height="46" width="740" x="500" y="447" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_s5" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="⑥ RunInLoop → RegisterAndSend&#xa;rpc_channel.cpp:265" vertex="1">
