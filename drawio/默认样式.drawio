        <mxCell id="pg3" value="③ 箭头 + 标签成套样式（每组请连同两端框一起复制）" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="732" as="geometry" />
        </mxCell>
        <mxCell id="p3note" value="标签位置：默认「压线」（labelBackgroundColor=#ffffff，密集图首选）。想让它浮到箭头上方 → 选中连线后拖线上那个黄色标签手柄（drawio 自动记进样式），或用第 ② 组那种独立文本块。&#xa;拐弯形状：rounded=0 直角 / rounded=1 圆角。虚线 dashed=1 一律表示「不是同步返回」。连线必须连同两端的框一起复制，否则样式对不上。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pg3">
          <mxGeometry x="30" y="45" width="1760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p3d0" value="① 箭头 + 压线标签（推荐）&#xa;rounded=0; labelBackgroundColor=#ffffff" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg3">
          <mxGeometry x="30" y="125" width="820" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3n0a" value="起点框&#xa;file.cpp:NNN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg3">
          <mxGeometry x="50" y="187" width="170" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p3n0b" value="终点框&#xa;file.cpp:NNN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg3">
          <mxGeometry x="360" y="187" width="170" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p3t0" value="用途：主干 / 同步路径。&#xa;标签白底压住线，密集图首选" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg3">
