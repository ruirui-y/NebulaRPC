        </mxCell>
        <mxCell id="p5d1" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="② 同一个骨架，改成 3 步 ｜ 示例：RegisterAndSend 的三道闸门&#xa;每道闸门都是「当场失败、不排队」，彼此没有先后" vertex="1">
          <mxGeometry height="40" width="840" x="30" y="591" as="geometry" />
