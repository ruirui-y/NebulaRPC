        <mxCell id="p5g0_n1" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="调用方没设 deadline 就是 nullopt" vertex="1">
          <mxGeometry height="34" width="480" x="1250" y="279" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_n2" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="trace_id 由这里生成（§11 ③）" vertex="1">
