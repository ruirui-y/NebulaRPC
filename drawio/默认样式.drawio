        <mxCell id="p5g1_s0" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="① 连接态闸门：非 kConnected 当场失败&#xa;rpc_channel.cpp:284" vertex="1">
          <mxGeometry height="46" width="500" x="380" y="651" as="geometry" />
        </mxCell>
        <mxCell id="p5g1_s1" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="② 过载闸门：pending 满 → RejectOverloaded&#xa;rpc_channel.cpp:299" vertex="1">
          <mxGeometry height="46" width="500" x="380" y="709" as="geometry" />
        </mxCell>
        <mxCell id="p5g1_s2" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="③ 入队前已超时 → 直接 Timeout 完成&#xa;rpc_channel.cpp:315" vertex="1">
