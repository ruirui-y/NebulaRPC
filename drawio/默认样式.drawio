  <diagram id="pg5" name="⑤ 函数 · 分步（可增删）">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1900" pageHeight="1017" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg5" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="⑤ 一个函数做了什么：并列步骤用分叉 / 有序步骤用竖排链，步数自己增删" vertex="1">
          <mxGeometry height="937" width="1820" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p5note" parent="pg5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="一个函数做了哪几件事：【并列的】步骤（没有先后）→ 用分叉式，一步一个框；【有先后的】步骤 → 用竖排链式，只向下长、不占横向。&#xa;增删一步：框选「某个步骤框 + 它那条边」→ Ctrl+C / Ctrl+V → 改文字，主干折点会一起复制；若粘贴后边断了，从函数框右边框拉一条过去即可。&#xa;⚠ 别把步骤写在边标签上：边标签只有一行，步骤一多只能全塞进去，长了压线或被截断，也没法单独改其中某一步。" vertex="1">
          <mxGeometry height="100" width="1760" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p5d0" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="① 并列的步骤 → 分叉式 ｜ 示例：RpcChannel::CallMethod 做的六件事&#xa;N 想改成几步都行：3 步 / 5 步 / 8 步，骨架不变" vertex="1">
          <mxGeometry height="40" width="1720" x="30" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_fn" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="RpcChannel::CallMethod&#xa;rpc_channel.cpp:177" vertex="1">
          <mxGeometry height="76" width="300" x="30" y="345" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_s0" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="① done 非空校验 —— 空则 Invalid 完成&#xa;rpc_channel.cpp:183" vertex="1">
          <mxGeometry height="46" width="740" x="500" y="215" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_s1" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="② ResolveDeadline → deadline&#xa;rpc_channel.cpp:204" vertex="1">
          <mxGeometry height="46" width="740" x="500" y="273" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_s2" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="③ 生成 request_id / trace_id&#xa;rpc_channel.cpp:220" vertex="1">
          <mxGeometry height="46" width="740" x="500" y="331" as="geometry" />
        </mxCell>
        <mxCell id="p5g0_s3" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" value="④ RpcCodec::Encode 组帧&#xa;rpc_channel.cpp:230" vertex="1">
          <mxGeometry height="46" width="740" x="500" y="389" as="geometry" />
