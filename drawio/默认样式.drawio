        <mxCell id="p3t1" value="两种做法：① 选中连线拖那个黄色&#xa;标签手柄；② 像这样用独立文本块" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg3">
