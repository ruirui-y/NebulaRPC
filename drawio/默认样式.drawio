  <diagram id="pg1" name="① 常用框样式">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="735" math="0" shadow="0">
      <root>
        <mxCell id="0" />
