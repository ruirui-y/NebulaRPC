  <diagram id="pg2" name="② 连线 · 容器 · 组合">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg2" value="② 连线 · 容器 · 组合示例（连线请连同两端框一起复制）" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="540" as="geometry" />
        </mxCell>
        <mxCell id="p2note" value="连线要连同两端的框一起复制，否则样式对不上；泳道是容器，子节点坐标相对它（这是「只改泳道原点就能分页」的原因）。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pg2">
          <mxGeometry x="30" y="50" width="1760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2lane" value="泳道（容器）  startSize=28" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="pg2">
          <mxGeometry x="30" y="105" width="620" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p2b1" value="子节点坐标&#xa;相对泳道（parent）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2lane">
          <mxGeometry x="30" y="45" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2b2" value="拖动泳道&#xa;整组跟随" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2lane">
          <mxGeometry x="320" y="45" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2lane_t" value="容器语义：往里拖一个方块，它的 parent 就变成泳道，&#xa;坐标变成「相对泳道」。所以移动/缩放泳道时整组跟随。&#xa;⚠ 内容区高度 = 总高 − startSize(28)，留够余量。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg2">
          <mxGeometry x="680" y="105" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2a1" value="TcpConnection::Send&#xa;rpc_channel.cpp:417" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg2">
          <mxGeometry x="30" y="370" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2a2" value="RpcServer::OnMessage&#xa;rpc_server.cpp:157" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg2">
          <mxGeometry x="330" y="370" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2edge_t" value="主干 / 同步路径：edgeStyle=orthogonalEdgeStyle;rounded=0&#xa;标签白底 labelBackgroundColor=#ffffff" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg2">
          <mxGeometry x="600" y="370" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2b3" value="ForceClose&#xa;rpc_channel.cpp:574" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg2">
          <mxGeometry x="30" y="460" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2b4" value="Connector::Restart&#xa;连接重建" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;spacingLeft=6;spacingTop=3;" vertex="1" parent="pg2">
          <mxGeometry x="330" y="460" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2bedge_t" value="异步 / 回调 / 报丧线：同样串加 dashed=1&#xa;（虚线一律表示「不是同步返回」）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg2">
          <mxGeometry x="600" y="460" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2e1" value="网络" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="pg2" source="p2a1" target="p2a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e2" value="报丧线" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="pg2" source="p2b3" target="p2b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="③ 箭头 · 标签样式">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="812" math="0" shadow="0">
