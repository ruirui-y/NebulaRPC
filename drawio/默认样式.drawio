        <mxCell id="p5g1_fn" parent="pg5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="RpcChannel::RegisterAndSend&#xa;rpc_channel.cpp:274" vertex="1">
