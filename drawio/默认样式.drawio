        <mxCell id="p5g0_n5" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="真正干活的是投过去的那个闭包" vertex="1">
