        <mxCell id="p3d1" value="② 文字浮在箭头上方&#xa;不写 labelBackgroundColor + 独立文本块" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="pg3">
          <mxGeometry x="910" y="125" width="820" height="44" as="geometry" />
