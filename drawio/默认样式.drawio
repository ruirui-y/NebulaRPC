        </mxCell>
        <mxCell id="p5g0_n0" parent="pg5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="只在调用方线程上做，没进 loop" vertex="1">
